/*
  X-Robots-Tag: noindex, noimageindex
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https://assets.templateatlas.com data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=60

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/previews/*
  Cache-Control: public, max-age=31536000, immutable

/art/*
  Cache-Control: public, max-age=86400

/templateatlas-lockup-optimized.webp
  Cache-Control: public, max-age=86400

/favicon-32.png
  Cache-Control: public, max-age=86400
