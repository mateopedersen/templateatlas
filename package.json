    "better-auth": "1.7.15",
    "fflate": "0.8.3",
    "jose": "6.2.14",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "5.20261101.1",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.1-beta",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
