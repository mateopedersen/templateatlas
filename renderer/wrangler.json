{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "templateatlas-private-renderer",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled":false},
  "build": {"command":"node prepare-image.mjs"},
  "containers": [{
    "class_name":"RendererInstance",
    "image":"./image/Dockerfile",
    "image_build_context":"./image",
    "instance_type":"standard-1",
    "max_instances":1
  }],
  "durable_objects":{"bindings":[{"name":"RENDER_INSTANCES","class_name":"RendererInstance"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["RendererInstance"]}]
}
