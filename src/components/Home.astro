---
import { entries } from '../lib/catalog.mjs';
import Icon from './Icon.astro';
import StudioHero from './StudioHero.astro';
import CollectionTiles from './CollectionTiles.astro';
import ImageLicenseMetadata from './ImageLicenseMetadata.astro';
const groups = [
  {
    id: 'project',
    name: 'Project proposals',
    icon: 'brief',
    copy: 'Scope, budgets, and plans for your next engagement.',
    picks: [
      'project-proposal',
      'business-proposal',
      'budget-proposal',
      'consulting-proposal',
    ],
    search: 'proposal',
    tone: 'wine',
  },
  {
    id: 'invoice',
    name: 'Invoices & payments',
    icon: 'receipt',
    copy: 'Bill clients, track payments, and reconcile balances.',
    picks: [
      'invoice',
      'photography-invoice',
      'consulting-invoice',
      'service-invoice',
    ],
    search: 'invoice',
    tone: 'sage',
  },
  {
    id: 'calendar',
    name: '2027 calendars',
    icon: 'calendar',
    copy: 'Dated monthly layouts and U.S. holiday calendars.',
    picks: [
      'january-2027-calendar',
      '2027-us-holidays-calendar',
      '2027-monthly-planner',
      '2027-birthday-calendar',
    ],
    search: '2027 calendar',
    tone: 'sand',
  },
  {
    id: 'charts',
    name: 'Charts & graphs',
    icon: 'chart',
    copy: 'Editable data visualizations, dashboards, and diagrams.',
    picks: ['line-chart', 'scatter-plot', 'heatmap', 'pie-chart'],
    search: 'chart',
    tone: 'blue',
  },
  {
    id: 'meetings',
    name: 'Meeting agendas',
    icon: 'people',
    copy: 'Structure the discussion and capture decisions.',
    picks: [
      'meeting-agenda',
      'corporate-meeting-minutes',
      'conference-agenda',
      'board-meeting-agenda',
    ],
    search: 'meeting',
    tone: 'rose',
  },
  {
    id: 'career',
    name: 'Résumés & careers',
    icon: 'document',
    copy: 'Present your experience, credits, and academic work.',
    picks: [
      'college-resume',
      'acting-resume',
      'curriculum-vitae',
      'customer-service-resume',
    ],
    search: 'resume',
    tone: 'olive',
  },
]
  .map((g) => ({
    ...g,
    items: g.picks
      .map((k) =>
        entries.find(
          (x) => x.topic_slug === k && !Astro.locals.held?.has(x.id),
        ),
      )
      .filter(Boolean),
  }))
  .filter((g) => g.items.length);
const first = groups[0]?.items[0];
const compact = (s: any) => ({
  title: s.title,
  summary: s.summary,
  preview: s.preview,
  formats: s.formats,
  pages: s.pages,
  path: s.detail_path,
  topic: s.topic_path,
});
const data = Object.fromEntries(
  groups.flatMap((g) => g.items.map((s: any) => [s.id, compact(s)])),
);
---

<ImageLicenseMetadata images={groups.flatMap(g => g.items)} />
<div class="studio-landing">
  <StudioHero />
  <CollectionTiles />
  <div class="desk" data-desk data-records={JSON.stringify(data)}>
    <div class="ledger-main">
      <div class="ledger-sec-head">
        <div>
          <span class="kicker">
            <span class="kicker-dot"></span> Inside the library
          </span>
          <h2>
            Collection <em>workbench.</em>
          </h2>
        </div>
        <a href="/categories/">
          View all <Icon name="arrow" size={15} />
        </a>
      </div>
      <div class="shelf-list">
        {groups.map((g, ix) => (
          <details class={'shelf ' + g.tone} open={ix === 0} data-shelf>
            <summary>
              <span class="shelf-symbol">
                <Icon name={g.icon} size={23} />
              </span>
              <span class="shelf-info">
                <strong>{g.name}</strong>
                <small>{g.copy}</small>
              </span>
              <span class="shelf-chevron">⌄</span>
            </summary>
            <div class="shelf-books">
              {g.items.map((s: any, i) => (
                <button
                  type="button"
                  class="book-pick"
                  data-record={s.id}
                  aria-pressed={ix === 0 && i === 0 ? 'true' : 'false'}
                >
                  <span class={'book-image t' + i}>
                    <img src={s.preview} alt="" loading="lazy" />
                  </span>
                  <strong>{s.title}</strong>
                  <span class="format-pill">{s.formats[0].toUpperCase()}</span>
                </button>
              ))}
            </div>
          </details>
        ))}
      </div>
    </div>
    {first && (
      <aside class="spotlight">
        <div class="spot-head">
          <span class="kicker">
            <span class="status-dot"></span> Template preview
          </span>
          <Icon name="layers" size={15} />
        </div>
        <div class="spot-frame">
          <span class="frame-index">
            TEMPLATEATLAS <span> / </span> FOLIO
          </span>
          <img
            data-preview
            src={first.preview}
            alt={'Preview of ' + first.title}
          />
          <span class="frame-page" data-pages>
            1 / {first.pages}
          </span>
        </div>
        <div class="spot-body">
          <div class="spot-type" data-badges>
            {first.formats.map((f: string) => (
              <span class={'chip chip-' + f}>{f.toUpperCase()}</span>
            ))}
          </div>
          <h2 data-title>{first.title}</h2>
          <p data-copy>{first.summary}</p>
          <a class="button full" data-use href={first.detail_path}>
            View template <Icon name="arrow" size={17} />
          </a>
          <a class="spot-link" data-topic href={first.topic_path}>
            Open template controls <Icon name="chevron" size={12} />
          </a>
        </div>
        <div class="studio-promo">
          <Icon name="pen" size={22} />
          <strong>Your document studio</strong>
          <p>Start with your own details and build a working document.</p>
          <a href="/create/">Open Studio →</a>
        </div>
      </aside>
    )}
  </div>
</div>
<script>
  const root = document.querySelector<HTMLElement>('[data-desk]');
  if (root) {
    const data = JSON.parse(root.dataset.records!);
    function select(id: string) {
      const r = data[id];
      if (!r) return;
      root!
        .querySelectorAll<HTMLElement>('[data-record]')
        .forEach((b) =>
          b.setAttribute('aria-pressed', String(b.dataset.record === id)),
        );
      const img = root!.querySelector<HTMLImageElement>('[data-preview]')!;
      img.src = r.preview;
      img.alt = 'Preview of ' + r.title;
      root!.querySelector('[data-title]')!.textContent = r.title;
      root!.querySelector('[data-copy]')!.textContent = r.summary;
      root!.querySelector('[data-pages]')!.textContent = '1 / ' + r.pages;
      root!.querySelector<HTMLAnchorElement>('[data-use]')!.href = r.path;
      root!.querySelector<HTMLAnchorElement>('[data-topic]')!.href = r.topic;
      const badges = root!.querySelector('[data-badges]')!;
      badges.replaceChildren(
        ...r.formats.map((f: string) => {
          const s = document.createElement('span');
          s.className = 'chip chip-' + f;
          s.textContent = f.toUpperCase();
          return s;
        }),
      );
    }
    root.querySelectorAll<HTMLButtonElement>('[data-record]').forEach(
      (b) =>
        (b.onclick = () => {
          select(b.dataset.record!);
          if (matchMedia('(max-width:1100px)').matches)
            root
              .querySelector('.spotlight')!
              .scrollIntoView({ block: 'start' });
        }),
    );
    root.querySelectorAll<HTMLDetailsElement>('[data-shelf]').forEach((d) =>
      d.addEventListener('toggle', () => {
        if (!d.open) return;
        root
          .querySelectorAll<HTMLDetailsElement>('[data-shelf]')
          .forEach((o) => {
            if (o !== d) o.open = false;
          });
        select(d.querySelector<HTMLElement>('[data-record]')!.dataset.record!);
      }),
    );
  }
</script>
