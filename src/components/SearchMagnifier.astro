---
const id = 'lens-' + crypto.randomUUID();
---
<svg viewBox="0 0 48 48" width="36" height="36" aria-hidden="true" fill="none">
  <defs>
    <linearGradient id={id+'-rim'} x1="8" y1="7" x2="35" y2="36" gradientUnits="userSpaceOnUse"><stop stop-color="#fff6dc"/><stop offset=".25" stop-color="#dfb779"/><stop offset=".55" stop-color="#966341"/><stop offset=".77" stop-color="#f4d69e"/><stop offset="1" stop-color="#714b3c"/></linearGradient>
    <linearGradient id={id+'-glass'} x1="9" y1="8" x2="31" y2="34" gradientUnits="userSpaceOnUse"><stop stop-color="#fff"/><stop offset=".5" stop-color="#e9f3ee"/><stop offset="1" stop-color="#b6cfce"/></linearGradient>
    <linearGradient id={id+'-handle'} x1="29" y1="30" x2="42" y2="43" gradientUnits="userSpaceOnUse"><stop stop-color="#a75a73"/><stop offset=".45" stop-color="#743049"/><stop offset="1" stop-color="#4a1d35"/></linearGradient>
    <filter id={id+'-shadow'} x="-20%" y="-20%" width="150%" height="160%"><feGaussianBlur stdDeviation="1.1"/></filter>
  </defs>
  <path d="M30 30 41 41" stroke="#341726" stroke-width="6" stroke-linecap="round" opacity=".23" filter={`url(#${id}-shadow)`}/>
  <path d="M29 29 40 40" stroke={`url(#${id}-handle)`} stroke-width="6" stroke-linecap="round"/>
  <path d="M31 30.5 39 38.5" stroke="#e5acb2" stroke-width="1.1" stroke-linecap="round" opacity=".65"/>
  <circle cx="20" cy="20" r="15" fill={`url(#${id}-rim)`} stroke="#87613f" stroke-width=".8"/>
  <circle cx="20" cy="20" r="11.6" fill={`url(#${id}-glass)`} stroke="#718e89" stroke-width=".8"/>
  <path d="M12 17c1-4 4-6 8-6" stroke="#fff" stroke-width="2.3" stroke-linecap="round" opacity=".95"/>
  <path d="M15 25c3 2 6 3 9 1" stroke="#fff" stroke-width="1" stroke-linecap="round" opacity=".55"/>
</svg>
