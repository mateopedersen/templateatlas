---
const { lazy = false } = Astro.props;
---

<a class="brand" href="/" aria-label="TemplateAtlas home">
  <img
    alt=""
    width="960"
    height="229"
    src="/templateatlas-lockup-optimized.webp"
    decoding="async"
    loading={lazy ? "lazy" : "eager"}
    fetchpriority={lazy ? "low" : "high"}
  />
</a>
