---
const { add = false } = Astro.props;
const id = `account-${crypto.randomUUID()}`;
---
<svg viewBox="0 0 32 32" width="26" height="26" fill="none" aria-hidden="true">
 <defs>
  <linearGradient id={`${id}-skin`} x1="7" y1="5" x2="21" y2="20" gradientUnits="userSpaceOnUse"><stop stop-color="#ffdfb8"/><stop offset="1" stop-color="#b3836d"/></linearGradient>
  <linearGradient id={`${id}-coat`} x1="5" y1="15" x2="24" y2="29" gradientUnits="userSpaceOnUse"><stop stop-color="#af7183"/><stop offset="1" stop-color="#69334c"/></linearGradient>
 </defs>
 <circle cx="14" cy="10" r="5.2" fill={`url(#${id}-skin)`} stroke="#a87968" stroke-width=".6"/>
 <path d="M4.5 25.5c.6-5.6 4-8.7 9.5-8.7s8.9 3.1 9.5 8.7" fill={`url(#${id}-coat)`} stroke="#713b50" stroke-width=".6"/>
 <path d="M8.5 22c1-1.7 2.5-2.5 4.5-2.8" stroke="#e6bac1" stroke-width="1" stroke-linecap="round"/>
 {add && <><circle cx="24" cy="23" r="6.2" fill="#f8ead5" stroke="#b99473"/><path d="M24 20v6m-3-3h6" stroke="#713b50" stroke-width="1.5" stroke-linecap="round"/></>}
</svg>
