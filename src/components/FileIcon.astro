---
const { kind, class: className } = Astro.props;
const id = "file-" + crypto.randomUUID();
---
<svg class={className} width="32" height="32" viewBox="0 0 40 40" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={id + "paper"} x1="8" y1="4" x2="31" y2="37" gradientUnits="userSpaceOnUse"><stop stop-color="#fff"/><stop offset="1" stop-color="#dfd5ca"/></linearGradient>
    <linearGradient id={id + "accent"} x1="6" y1="18" x2="31" y2="34" gradientUnits="userSpaceOnUse"><stop stop-color={kind === "pdf" ? "#ee7184" : "#71bfc7"}/><stop offset="1" stop-color={kind === "pdf" ? "#982b4e" : "#326875"}/></linearGradient>
  </defs>
  {kind === "pdf" ? (
    <>
      <ellipse cx="21" cy="36" rx="13" ry="2" fill="#200d21" opacity=".22"/>
      <path d="M12 6h12l9 9v19a2 2 0 0 1-2 2H12a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2" fill="#b6a3aa"/>
      <path d="M10 4h13l9 9v19a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2" fill={"url(#" + id + "paper)"} stroke="#fff" stroke-opacity=".8" stroke-width=".6"/>
      <path d="m23 4 9 9h-7a2 2 0 0 1-2-2Z" fill="#fdfaf7"/><path d="M23 5v7a2 2 0 0 0 2 2h6" stroke="#c3b6b1" stroke-width=".8"/>
      <rect x="5" y="19" width="24" height="12" rx="3" fill="#55213a" opacity=".2"/>
      <rect x="4" y="17" width="24" height="12" rx="3" fill={"url(#" + id + "accent)"}/>
      <path d="M7 18h18" stroke="#fff" stroke-opacity=".4" stroke-linecap="round"/>
      <text x="16" y="25.8" text-anchor="middle" fill="white" font-family="Arial,sans-serif" font-size="8" font-weight="800" letter-spacing=".3">PDF</text>
      <path d="M12 10h6M12 13h7" stroke="#bcb0ae" stroke-width="1.3" stroke-linecap="round"/>
    </>
  ) : kind === "excel" ? (
    <>
      <ellipse cx="21" cy="36" rx="13" ry="2" fill="#183a2c" opacity=".18"/>
      <path d="M12 6h12l9 9v19a2 2 0 0 1-2 2H12a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2" fill="#abc4b8"/>
      <path d="M10 4h13l9 9v19a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2" fill={'url(#' + id + 'paper)'} stroke="#fff" stroke-width=".7"/>
      <path d="M23 4v7a2 2 0 0 0 2 2h7" fill="#deeee5" stroke="#9dbbaa" stroke-width=".7"/>
      <path d="M22 18h7M22 23h7M22 28h7M25 17v13" stroke="#9dbbaa" stroke-width=".8"/>
      <rect x="4" y="17" width="18" height="14" rx="3" fill="#246649"/>
      <path d="M5.5 18.5h15" stroke="#b6dcc7" stroke-opacity=".6"/>
      <path d="m10 21 6 7m0-7-6 7" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/>
    </>
  ) : kind === "odt" ? (
    <>
      <ellipse cx="21" cy="36" rx="13" ry="2" fill="#234454" opacity=".18"/>
      <path d="M12 6h12l9 9v19a2 2 0 0 1-2 2H12a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2" fill="#a5bfcb"/>
      <path d="M10 4h13l9 9v19a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2" fill="#f7fcff" stroke="#c5d9e3" stroke-width=".7"/>
      <path d="m23 4 9 9h-7a2 2 0 0 1-2-2Z" fill="#d8e8f0"/>
      <path d="M12 10h6M12 13h7M25 19h4M25 23h4M25 27h4" stroke="#9bb8c8" stroke-width="1.2" stroke-linecap="round"/>
      <rect x="4" y="17" width="24" height="14" rx="3" fill="#31566d"/>
      <path d="M5.5 18.5h21" stroke="#b4deec" stroke-opacity=".65"/>
      <text x="16" y="26.7" text-anchor="middle" fill="#fff" font-family="Arial,sans-serif" font-size="7.5" font-weight="800">ODT</text>
    </>
  ) : kind === "google-docs" ? (
    <>
      <ellipse cx="21" cy="36" rx="13" ry="2" fill="#17385e" opacity=".18"/>
      <path d="M11 5h13l8 8v20a3 3 0 0 1-3 3H11a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3Z" fill="#dcecff" stroke="#aac5e6"/>
      <path d="M24 5v8h8" fill="#b4d4f7"/><rect x="5" y="17" width="23" height="14" rx="3" fill="#3979cf"/>
      <path d="M9 21h14M9 24h14M9 27h9" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M25 29l7-7m-4 0h4v4" stroke="#6b294a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    </>
  ) : kind === "word" ? (
    <>
      <ellipse cx="21" cy="36" rx="13" ry="2" fill="#14293b" opacity=".18"/>
      <path d="M12 6h12l9 9v19a2 2 0 0 1-2 2H12a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2" fill="#aebdcb"/>
      <path d="M10 4h13l9 9v19a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2" fill={'url(#' + id + 'paper)'} stroke="#fff" stroke-width=".7"/>
      <path d="M23 4v7a2 2 0 0 0 2 2h7" fill="#e2ebf4" stroke="#a4b7c7" stroke-width=".7"/>
      <path d="M25 18h4M25 22h4M25 26h4" stroke="#93aec4" stroke-width="1.2" stroke-linecap="round"/>
      <rect x="4" y="17" width="20" height="14" rx="3" fill="#285c8b"/>
      <path d="M5.5 18.5h17" stroke="#b7d9f3" stroke-opacity=".65"/>
      <text x="14" y="27.4" text-anchor="middle" fill="#fff" font-family="Arial,sans-serif" font-size="10" font-weight="800">W</text>
    </>
  ) : kind === "image" ? (
    <>
      <ellipse cx="21" cy="35" rx="15" ry="2" fill="#302735" opacity=".15"/>
      <rect x="7" y="6" width="28" height="28" rx="3" transform="rotate(8 21 20)" fill="#c9b7ae"/>
      <rect x="4" y="5" width="29" height="28" rx="3" transform="rotate(-6 18 19)" fill={"url(#" + id + "paper)"} stroke="#fff" stroke-width=".8"/>
      <g transform="rotate(-6 18 19)">
        <rect x="7" y="8" width="23" height="19" rx="1.5" fill={"url(#" + id + "accent)"}/>
        <circle cx="24" cy="13" r="3" fill="#ffe1a0"/>
        <path d="m7 25 8-11 8 13H7Z" fill="#35685e"/><path d="m15 14-3 4 3-1 3 1Z" fill="#f5f2e3"/>
        <path d="m17 27 7-10 6 7v3Z" fill="#78a68b"/>
        <path d="M10 30h10" stroke="#b5a8a4" stroke-width="1.2" stroke-linecap="round"/>
      </g>
    </>
  ) : (
    <g stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6v19m-6-6 6 6 6-6M9 27v5a2 2 0 0 0 2 2h18a2 2 0 0 0 2-2v-5"/></g>
  )}
</svg>
