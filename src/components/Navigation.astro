---
import categories from '../data/categories.json';
import { tools } from '../lib/tools.mjs';
import Icon from './Icon.astro';
import AtlasEmblem from './AtlasEmblem.astro';
import NavigationObject from './NavigationObject.astro';
import WorkbenchArt from './WorkbenchArt.astro';
const path = Astro.url.pathname;
const groups = [
  {title:'Work & business', motif:'portfolio', paths:['business-commerce','resumes-careers','legal-official-documents','real-estate-rental','construction-maintenance']},
  {title:'Design & learning', motif:'draft', paths:['charts-graphs','education-academic','design-creative','music-instruments']},
  {title:'Everyday planning', motif:'calendar', paths:['planners','monthly','holidays','home-lifestyle','health-medical','food-cooking']},
  {title:'Leisure & travel', motif:'compass', paths:['special-events-occasions','travel-trip-planning','vehicles-transportation','sports-recreation','games-entertainment']},
];
const names: Record<string,string> = {
 'business-commerce':'Business & Finance','legal-official-documents':'Legal & Official Documents','real-estate-rental':'Real Estate & Rental','construction-maintenance':'Construction & Maintenance','education-academic':'Education & Academic','design-creative':'Design & Creative','music-instruments':'Music & Instruments','monthly':'Monthly Calendars','home-lifestyle':'Home & Lifestyle','health-medical':'Health & Medical','food-cooking':'Food & Cooking','special-events-occasions':'Events & Occasions','travel-trip-planning':'Travel & Trips','vehicles-transportation':'Vehicles & Transportation','sports-recreation':'Sports & Recreation','games-entertainment':'Games & Entertainment'
};
const create = [
 ['Chart maker','Turn your data into a chart','/create/chart/','chart'],
 ['Invoice maker','Create a client-ready invoice','/create/invoice/','invoice'],
 ['Form builder','Build a form from scratch','/create/form/','form'],
 ['Calendar maker','Make a calendar for your plans','/create/calendar/','calendar'],
 ['Planner maker','Organize projects and routines','/create/planner/','planner'],
 ['Agreement maker','Start a structured agreement','/create/agreement/','agreement'],
 ['Design studio','Create a visual layout','/create/design/','design'],
 ['Diagram maker','Map out ideas and processes','/create/diagram/','diagram'],
 ['Spreadsheet maker','Build a working spreadsheet','/create/spreadsheet/','spreadsheet'],
 ['Presentation maker','Create a presentation','/create/presentation/','presentation'],
];
---
<nav class="atlas-nav" aria-label="Main navigation" data-atlas-nav>
  <details class="atlas-nav-item atlas-categories">
    <summary class:list={[{ current: /^\/(templates|categories|search)\//.test(path) }]}><NavigationObject kind="categories" />Categories <span class="nav-chevron" aria-hidden="true"></span></summary>
    <div class="nav-panel nav-category-panel">
      <div class="library-intro">
        <div class="library-folio"><img src="/library-folio-3d.webp" alt="" width="900" height="600" /></div>
        <div class="library-intro-copy"><span>THE TEMPLATEATLAS LIBRARY</span><strong>Find your next<br />great starting point.</strong><a href="/categories/">Explore all categories <Icon name="arrow" size={15}/></a></div>
      </div>
      <div class="nav-category-grid">
        {groups.map(group => <section><div class="shelf-emblem"><AtlasEmblem motif={group.motif} size={44} /></div><h2>{group.title}</h2>{group.paths.map(slug => {const cat=categories.find(c=>c.path===`/categories/${slug}/`); return cat && <a href={cat.path}>{names[slug] || cat.title}<Icon name="chevron" size={12}/></a>})}</section>)}
      </div>
      <div class="library-bottom"><span>Discover something useful</span><a href="/templates/">See all templates <Icon name="arrow" size={14}/></a></div>
    </div>
  </details>
  <details class="atlas-nav-item"><summary class:list={[{ current: /^\/(create|studio)\//.test(path) }]}><NavigationObject kind="create" />Create <span class="nav-chevron" aria-hidden="true"></span></summary>
    <div class="nav-panel nav-small-panel"><div class="nav-panel-heading"><div><strong>Create from scratch</strong><p>Build and customize with our editors.</p></div></div><div class="nav-feature-list">{create.map(([title,copy,href,icon])=><a href={href}><span class="nav-feature-icon"><WorkbenchArt kind={icon} /></span><span><strong>{title}</strong><small>{copy}</small></span><Icon name="chevron" size={13}/></a>)}</div><div class="nav-panel-footer"><a href="/create/">Explore all creators <Icon name="arrow" size={14}/></a></div></div>
  </details>
  <details class="atlas-nav-item"><summary class:list={[{ current: /^\/tools\//.test(path) }]}><NavigationObject kind="tools" />Tools <span class="nav-chevron" aria-hidden="true"></span></summary>
    <div class="nav-panel nav-small-panel"><div class="nav-panel-heading"><div><strong>Tools for everyday tasks</strong><p>Calculate, convert, and plan.</p></div></div><div class="nav-tool-grid">{Object.entries(tools).map(([slug,tool])=><a href={`/tools/${slug}/`}><span class="nav-feature-icon"><WorkbenchArt kind={slug} /></span><span class="nav-tool-copy"><strong>{tool.title}</strong><small>{tool.intro}</small></span><Icon name="chevron" size={13}/></a>)}</div><div class="nav-panel-footer"><a href="/tools/">Explore all tools <Icon name="arrow" size={14}/></a></div></div>
  </details>
  <a class:list={["nav-direct", { current: path.startsWith("/help/") }]} href="/help/"><NavigationObject kind="help" />Help</a>
  <div class="nav-quick-links" aria-label="Explore the library">
    <span class="nav-quick-label">Explore</span>
    <a href="/templates/"><WorkbenchArt kind="design" /><span>All Templates</span></a>
    <a href="/categories/charts-graphs/"><WorkbenchArt kind="chart" /><span>Charts &amp; Graphs</span></a>
    <a href="/tools/calendar-2027/"><WorkbenchArt kind="calendar" /><span>2027 Calendar</span></a>
  </div>
</nav>
<script>
 const nav = document.querySelector<HTMLElement>('[data-atlas-nav]');
 if (nav) {
   const menus = [...nav.querySelectorAll<HTMLDetailsElement>('details')];
   menus.forEach(menu => menu.addEventListener('toggle', () => {if (menu.open) menus.forEach(other => {if(other !== menu) other.open = false;});}));
   document.addEventListener('click', e => {if (!nav.contains(e.target as Node)) menus.forEach(menu => menu.open = false);});
   document.addEventListener('keydown', e => {if(e.key === 'Escape') {const open=menus.find(menu=>menu.open); if(open) {open.open=false; open.querySelector('summary')?.focus();}}});
 }
</script>
