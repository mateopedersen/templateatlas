---
import categories from '../data/categories.json';
import { tools } from '../lib/tools.mjs';
import Icon from './Icon.astro';
import MenuArt from './MenuArt.astro';
const path = Astro.url.pathname;
const titleCase = (value: string) => value.replace(/\b[a-z]/g, letter => letter.toUpperCase());
const groups = [
  {title:'Work & business', motif:'portfolio', paths:['business-commerce','resumes-careers','legal-official-documents','real-estate-rental','construction-maintenance']},
  {title:'Design & learning', motif:'draft', paths:['charts-graphs','education-academic','design-creative','music-instruments']},
  {title:'Everyday planning', motif:'calendar', paths:['planners','monthly','holidays','home-lifestyle','health-medical','food-cooking']},
  {title:'Leisure & travel', motif:'compass', paths:['special-events-occasions','travel-trip-planning','vehicles-transportation','sports-recreation','games-entertainment']},
];
const names: Record<string,string> = {
 'business-commerce':'Business & Finance','legal-official-documents':'Legal & Official Documents','real-estate-rental':'Real Estate & Rental','construction-maintenance':'Construction & Maintenance','education-academic':'Education & Academic','design-creative':'Design & Creative','music-instruments':'Music & Instruments','monthly':'Monthly Calendars','home-lifestyle':'Home & Lifestyle','health-medical':'Health & Medical','food-cooking':'Food & Cooking','special-events-occasions':'Events & Occasions','travel-trip-planning':'Travel & Trips','vehicles-transportation':'Vehicles & Transportation','sports-recreation':'Sports & Recreation','games-entertainment':'Games & Entertainment'
};
const create = [
 ['Chart maker','Turn your data into a chart','/create/chart/','chart'],
 ['Invoice maker','Create a client-ready invoice','/create/invoice/','invoice'],
 ['Form builder','Build a form from scratch','/create/form/','form'],
 ['Calendar maker','Make a calendar for your plans','/create/calendar/','calendar'],
 ['Planner maker','Organize projects and routines','/create/planner/','planner'],
 ['Agreement maker','Start a structured agreement','/create/agreement/','agreement'],
 ['Design studio','Create a visual layout','/create/design/','design'],
 ['Diagram maker','Map out ideas and processes','/create/diagram/','diagram'],
 ['Spreadsheet maker','Build a working spreadsheet','/create/spreadsheet/','spreadsheet'],
 ['Presentation maker','Create a presentation','/create/presentation/','presentation'],
];
---
<nav class="atlas-nav" aria-label="Main navigation" data-atlas-nav>
  <details class="atlas-nav-item atlas-categories">
    <summary class:list={[{ current: /^\/(templates|categories|search)\//.test(path) }]}><MenuArt kind="categories" />Categories <span class="nav-chevron" aria-hidden="true"></span></summary>
    <div class="nav-panel nav-drawer category-drawer">
      <div class="drawer-heading"><div><span class="drawer-kicker">The TemplateAtlas Library</span><strong>Find Your Starting Point</strong><p>Explore Ideas For Work, Learning, And Everyday Life.</p></div><a class="drawer-heading-link" href="/categories/">All Categories <Icon name="arrow" size={15}/></a></div>
      <div class="category-browser" data-category-browser>
        <div class="category-tabs" role="tablist" aria-label="Browse category groups">
          {groups.map((group,index)=><button type="button" role="tab" id={`nav-tab-${index}`} aria-controls={`nav-group-${index}`} aria-selected={index===0 ? 'true' : 'false'} tabindex={index===0 ? '0' : '-1'} data-category-tab><span class="tab-number">{String(index+1).padStart(2,'0')}</span><span>{titleCase(group.title)}</span><Icon name="chevron" size={14}/></button>)}
        </div>
        <div class="category-contents">
          {groups.map((group,index)=><section id={`nav-group-${index}`} role="tabpanel" aria-labelledby={`nav-tab-${index}`} data-category-group><div class="group-heading"><span>Explore</span><h2>{titleCase(group.title)}</h2></div><div class="category-tiles">{group.paths.map(slug=>{const cat=categories.find(c=>c.path===`/categories/${slug}/`);return cat && <a href={cat.path}><span class="drawer-art"><MenuArt kind={slug}/></span><span>{titleCase(names[slug] || cat.title)}</span><Icon name="arrow" size={14}/></a>})}</div></section>)}
        </div>
      </div>
      <div class="drawer-footer"><div class="drawer-scroll-tools" hidden><span>Explore More</span><button type="button" data-scroll-up aria-label="Scroll categories up"><Icon name="chevron" size={14}/></button><button type="button" data-scroll-down aria-label="Scroll categories down"><Icon name="chevron" size={14}/></button></div><a href="/templates/">Browse All Templates <Icon name="arrow" size={14}/></a></div>
    </div>
  </details>
  <details class="atlas-nav-item"><summary class:list={[{ current: /^\/(create|studio)\//.test(path) }]}><MenuArt kind="create" />Create <span class="nav-chevron" aria-hidden="true"></span></summary>
    <div class="nav-panel nav-drawer maker-drawer"><div class="drawer-heading"><div><span class="drawer-kicker">Your Creative Workspace</span><strong>Make It Your Own</strong><p>Choose An Editor. Shape Your Next Idea.</p></div><a class="drawer-heading-link" href="/create/">All Creators <Icon name="arrow" size={15}/></a></div><div class="drawer-scroll" tabindex="0" aria-label="Browse creators"><div class="drawer-list">{create.map(([title,copy,href,icon])=><a href={href}><span class="drawer-art"><MenuArt kind={icon} /></span><span class="drawer-copy"><strong>{titleCase(title)}</strong><small>{titleCase(copy)}</small></span><Icon name="arrow" size={14}/></a>)}</div></div><div class="drawer-footer"><div class="drawer-scroll-tools" hidden><span>Explore More</span><button type="button" data-scroll-up aria-label="Scroll creators up"><Icon name="chevron" size={14}/></button><button type="button" data-scroll-down aria-label="Scroll creators down"><Icon name="chevron" size={14}/></button></div><a href="/create/">Explore All Creators <Icon name="arrow" size={14}/></a></div></div>
  </details>
  <details class="atlas-nav-item"><summary class:list={[{ current: /^\/tools\//.test(path) }]}><MenuArt kind="tools" />Tools <span class="nav-chevron" aria-hidden="true"></span></summary>
    <div class="nav-panel nav-drawer maker-drawer"><div class="drawer-heading"><div><span class="drawer-kicker">The Everyday Toolkit</span><strong>The Right Tool, Within Reach</strong><p>Calculate, Convert, And Plan With Confidence.</p></div><a class="drawer-heading-link" href="/tools/">All Tools <Icon name="arrow" size={15}/></a></div><div class="drawer-scroll" tabindex="0" aria-label="Browse tools"><div class="drawer-list">{Object.entries(tools).map(([slug,tool])=><a href={`/tools/${slug}/`}><span class="drawer-art"><MenuArt kind={slug} /></span><span class="drawer-copy"><strong>{titleCase(tool.title)}</strong><small>{titleCase(tool.intro)}</small></span><Icon name="arrow" size={14}/></a>)}</div></div><div class="drawer-footer"><div class="drawer-scroll-tools" hidden><span>Explore More</span><button type="button" data-scroll-up aria-label="Scroll tools up"><Icon name="chevron" size={14}/></button><button type="button" data-scroll-down aria-label="Scroll tools down"><Icon name="chevron" size={14}/></button></div><a href="/tools/">Explore All Tools <Icon name="arrow" size={14}/></a></div></div>
  </details>
  <a class:list={["nav-direct", { current: path.startsWith("/help/") }]} href="/help/"><MenuArt kind="help" />Help</a>
  <div class="nav-quick-links" aria-label="Explore the library">
    <span class="nav-quick-label">Explore</span>
    <a href="/templates/"><MenuArt kind="resume" /><span>All Templates</span></a>
    <a href="/categories/charts-graphs/"><MenuArt kind="chart" /><span>Charts &amp; Graphs</span></a>
    <a href="/tools/calendar-2027/"><MenuArt kind="year" /><span>2027 Calendar</span></a>
  </div>
</nav>
<script>
 const nav = document.querySelector<HTMLElement>('[data-atlas-nav]');
 if (nav) {
   const menus = [...nav.querySelectorAll<HTMLDetailsElement>('details')];
   const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
   const refreshDrawer = (menu: HTMLDetailsElement) => {
     if (!menu.open) return;
     const drawer = menu.querySelector<HTMLElement>('.nav-drawer');
     if (!drawer) return;
     drawer.style.setProperty('--drawer-space', `${Math.max(180, innerHeight - nav.getBoundingClientRect().bottom - 16)}px`);
     const scroll = drawer.querySelector<HTMLElement>('.drawer-scroll, .category-contents');
     const controls = drawer.querySelector<HTMLElement>('.drawer-scroll-tools');
     if (!scroll || !controls) return;
     controls.hidden = scroll.scrollHeight <= scroll.clientHeight + 2;
     controls.querySelector<HTMLButtonElement>('[data-scroll-up]')!.disabled = scroll.scrollTop < 3;
     controls.querySelector<HTMLButtonElement>('[data-scroll-down]')!.disabled = scroll.scrollTop + scroll.clientHeight >= scroll.scrollHeight - 3;
   };
   menus.forEach(menu => {
     const scroll = menu.querySelector<HTMLElement>('.drawer-scroll, .category-contents');
     scroll?.addEventListener('scroll', () => refreshDrawer(menu), {passive:true});
     // Font and content layout can settle after the menu first opens.
     // Keep scroll controls tied to the final available space.
     const contentSize = new ResizeObserver(() => requestAnimationFrame(() => refreshDrawer(menu)));
     if (scroll) {
       contentSize.observe(scroll);
       if (scroll.firstElementChild) contentSize.observe(scroll.firstElementChild);
     }
     menu.querySelectorAll<HTMLButtonElement>('[data-scroll-up], [data-scroll-down]').forEach(button => button.addEventListener('click', () => scroll?.scrollBy({top: (button.hasAttribute('data-scroll-up') ? -1 : 1) * scroll.clientHeight * .7, behavior: reduceMotion.matches ? 'instant' : 'smooth'})));
     menu.addEventListener('toggle', () => requestAnimationFrame(() => refreshDrawer(menu)));
   });
   addEventListener('resize', () => menus.forEach(refreshDrawer));
   new ResizeObserver(() => menus.forEach(refreshDrawer)).observe(nav);
   document.fonts.ready.then(() => menus.forEach(refreshDrawer));
   menus.forEach(menu => menu.querySelector('summary')?.addEventListener('click', () => menus.forEach(other => {if(other !== menu) other.open = false;})));
   menus.forEach(menu => menu.addEventListener('toggle', () => {if (menu.open) menus.forEach(other => {if(other !== menu) other.open = false;});}));
   const browser = nav.querySelector<HTMLElement>('[data-category-browser]');
   if (browser) {
     const tabs = [...browser.querySelectorAll<HTMLButtonElement>('[data-category-tab]')];
     const groups = [...browser.querySelectorAll<HTMLElement>('[data-category-group]')];
     const select = (index: number, focus = false) => { tabs.forEach((tab,i) => {tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; groups[i].hidden = i !== index;}); const scroll = browser.querySelector<HTMLElement>('.category-contents'); if(scroll) scroll.scrollTop = 0; if(focus) {tabs[index].focus(); tabs[index].scrollIntoView({block:'nearest',inline:'nearest',behavior:'instant'});} requestAnimationFrame(() => menus.forEach(refreshDrawer)); };
     tabs.forEach((tab,i) => {tab.addEventListener('click', () => select(i)); tab.addEventListener('keydown', e => {if(e.key === 'ArrowDown' || e.key === 'ArrowRight') {e.preventDefault(); select((i+1)%tabs.length,true);} else if(e.key === 'ArrowUp' || e.key === 'ArrowLeft') {e.preventDefault(); select((i+tabs.length-1)%tabs.length,true);} else if(e.key === 'Home') {e.preventDefault(); select(0,true);} else if(e.key === 'End') {e.preventDefault(); select(tabs.length-1,true);}});});
     select(0);
   }
   document.addEventListener('click', e => {if (!nav.contains(e.target as Node)) menus.forEach(menu => menu.open = false);});
   document.addEventListener('keydown', e => {if(e.key === 'Escape') {const open=menus.find(menu=>menu.open); if(open) {menus.forEach(menu => menu.open=false); open.querySelector('summary')?.focus();}}});
 }
</script>
