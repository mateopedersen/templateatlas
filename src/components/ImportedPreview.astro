---
const { item } = Astro.props;
const pages = item.previewPages || [{page:1,url:item.preview,size:item.previewSize}];
const multiple = pages.length > 1;
---
<div class="document-preview" data-page-preview>
  {multiple && <div class="document-preview-toolbar">
    <strong>Document Preview</strong>
    <div class="document-page-tabs" role="tablist" aria-label="Preview document pages">
      {pages.map((page:any,index:number)=><button type="button" role="tab" id={`${item.id}-page-tab-${index}`} aria-controls={`${item.id}-page-panel-${index}`} aria-selected={index===0?'true':'false'} tabindex={index===0?0:-1} data-preview-page={index}>Page {page.page}</button>)}
    </div>
  </div>}
  {pages.map((page:any,index:number)=><section id={`${item.id}-page-panel-${index}`} role={multiple?'tabpanel':undefined} aria-labelledby={multiple?`${item.id}-page-tab-${index}`:undefined} data-preview-panel hidden={index!==0}>
    <a class="imported-large-preview" href={page.url} aria-label={`Enlarge preview${multiple?` page ${page.page}`:''} of ${item.title}`}>
      <img src={index === 0 && item.thumbnailAsset ? `https://assets.templateatlas.com${item.thumbnailAsset.path}` : page.url} alt={multiple?`${item.title} — page ${page.page} of ${pages.length}`:item.alt} width={page.size?.[0]} height={page.size?.[1]} loading={index===0?'eager':'lazy'} fetchpriority={index===0?'high':'auto'}/>
    </a>
    {multiple && <p class="document-page-caption">Page {page.page} Of {pages.length} · {item.paper}</p>}
  </section>)}
  <dialog class="preview-lightbox" aria-label={`Enlarged preview of ${item.title}`}>
    <div class="preview-lightbox-bar">
      <strong data-zoom-page>Page 1 Of {pages.length}</strong>
      <div class="preview-lightbox-actions">
        {multiple && <><button type="button" data-zoom-prev aria-label="Previous page">← Previous</button><button type="button" data-zoom-next>Next →</button></>}
        <button type="button" data-zoom-out aria-label="Zoom out">−</button><span data-zoom-level>100%</span><button type="button" data-zoom-in aria-label="Zoom in">+</button><button type="button" data-zoom-close>Close</button>
      </div>
    </div>
    <div class="preview-lightbox-scroll"><img alt="" data-zoom-image /></div>
  </dialog>
</div>
<script>
 for (const root of document.querySelectorAll<HTMLElement>('[data-page-preview]')) {
  const tabs=[...root.querySelectorAll<HTMLButtonElement>('[data-preview-page]')];
  const panels=[...root.querySelectorAll<HTMLElement>('[data-preview-panel]')];
  const dialog=root.querySelector<HTMLDialogElement>('.preview-lightbox')!;
  const zoomImage=dialog.querySelector<HTMLImageElement>('[data-zoom-image]')!;
  const level=dialog.querySelector<HTMLElement>('[data-zoom-level]')!;
  const caption=dialog.querySelector<HTMLElement>('[data-zoom-page]')!;
  let current=0, zoom=100;
  const showZoom=()=>{const source=panels[current].querySelector<HTMLImageElement>('img')!;zoomImage.src=panels[current].querySelector<HTMLAnchorElement>('a')!.href;zoomImage.alt=source.alt;zoomImage.style.width=`${zoom}%`;level.textContent=`${zoom}%`;caption.textContent=`Page ${current+1} Of ${panels.length}`;const prev=dialog.querySelector<HTMLButtonElement>('[data-zoom-prev]'),next=dialog.querySelector<HTMLButtonElement>('[data-zoom-next]');if(prev)prev.disabled=current===0;if(next)next.disabled=current===panels.length-1;};
  panels.forEach((panel,index)=>panel.querySelector('a')?.addEventListener('click',event=>{if(typeof dialog.showModal!=='function')return;event.preventDefault();current=index;zoom=100;showZoom();dialog.showModal();}));
  dialog.querySelector('[data-zoom-close]')?.addEventListener('click',()=>dialog.close());
  dialog.querySelector('[data-zoom-in]')?.addEventListener('click',()=>{zoom=Math.min(250,zoom+25);showZoom();});
  dialog.querySelector('[data-zoom-out]')?.addEventListener('click',()=>{zoom=Math.max(50,zoom-25);showZoom();});
  dialog.querySelector('[data-zoom-prev]')?.addEventListener('click',()=>{if(current>0){current--;showZoom();}});
  dialog.querySelector('[data-zoom-next]')?.addEventListener('click',()=>{if(current<panels.length-1){current++;showZoom();}});
  const select=(index:number,focus=false)=>{tabs.forEach((tab,i)=>{tab.setAttribute('aria-selected',String(i===index));tab.tabIndex=i===index?0:-1;panels[i].hidden=i!==index;});if(focus)tabs[index].focus();};
  tabs.forEach((tab,index)=>{
   tab.addEventListener('click',()=>select(index));
   tab.addEventListener('keydown',e=>{let next=index;if(e.key==='ArrowRight')next=(index+1)%tabs.length;else if(e.key==='ArrowLeft')next=(index+tabs.length-1)%tabs.length;else if(e.key==='Home')next=0;else if(e.key==='End')next=tabs.length-1;else return;e.preventDefault();select(next,true);});
  });
 }
</script>
