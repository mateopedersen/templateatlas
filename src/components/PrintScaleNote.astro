---
const { note } = Astro.props;
---
<section class="print-scale-note" aria-label="Printing guidance">
  <header>
    {note.calibration_square === false ? (
    <svg viewBox="0 0 72 72" width="58" height="58" fill="none" aria-hidden="true">
      <path d="M20 8h22l12 12v42H20z" fill="white" stroke="currentColor" stroke-width="1.8"/>
      <path d="M42 8v13h12M27 31h20M27 39h20M27 47h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <path d="M28 56h22" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity=".45"/>
    </svg>
    ) : (
    <svg viewBox="0 0 72 72" width="58" height="58" fill="none" aria-hidden="true">
      <rect x="18" y="18" width="38" height="38" rx="2" fill="white" stroke="currentColor" stroke-width="1.8"/>
      <path d="M18 9h38M18 6v6M56 6v6M9 18v38M6 18h6M6 56h6" stroke="currentColor" stroke-width="1.4"/>
      <path d="M22 52 52 22M27 56v-5m10 5v-5m10 5v-5M18 27h5m-5 10h5m-5 10h5" stroke="currentColor" opacity=".35"/>
      <text x="37" y="40" text-anchor="middle" fill="currentColor" font-family="Arial,sans-serif" font-size="13" font-weight="700">20</text>
      <text x="37" y="49" text-anchor="middle" fill="currentColor" font-family="Arial,sans-serif" font-size="7">mm</text>
    </svg>
    )}
    <div><h2>{note.title}</h2><p>{note.intro}</p></div>
  </header>
  <ol>{note.steps.map((step:any, index:number) => <li><span class="step-number" aria-hidden="true">{index+1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol>
</section>
<style>
  .print-scale-note{margin:1.25rem 0 1.75rem;padding:1.15rem 1.35rem;border:1px solid #dce8ee;border-radius:18px;background:linear-gradient(115deg,#f0f7fa,#fff 70%);color:#382833;box-shadow:0 5px 18px #32465106}
  header{display:flex;align-items:center;gap:.85rem;margin-bottom:1rem}header svg{flex:none;color:#763c55}h2{margin:0;font-size:1.2rem;line-height:1.3;font-weight:750}header p{margin:.2rem 0 0;color:#52616a;font-size:.94rem}
  ol{display:grid;grid-template-columns:1fr 1fr 1.4fr;gap:1.5rem;list-style:none;padding:0;margin:0}li{display:flex;align-items:flex-start;gap:.65rem;min-width:0}.step-number{flex:none;display:grid;place-items:center;width:26px;height:26px;border-radius:50%;border:1px solid #d9c4ce;background:#fff;color:#70394f;font-size:.8rem;font-weight:750}h3{margin:.1rem 0 .35rem;font-size:.96rem;line-height:1.3;font-weight:750}li p{margin:0;font-size:.91rem;line-height:1.55;color:#45535d}
  @media(max-width:700px){.print-scale-note{padding:1rem}ol{grid-template-columns:1fr;gap:1rem}header{gap:.5rem}header svg{width:48px;height:48px}h2{font-size:1.1rem}}
</style>
