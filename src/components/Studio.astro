---
import { entries } from '../lib/catalog.mjs';
import Customize from './Customize.astro';
import Icon from './Icon.astro';
import ImageLicenseMetadata from './ImageLicenseMetadata.astro';
const familyMap: Record<string, [string, string, string[]]> = {
  agreement: [
    'Agreement studio',
    'Prepare a working draft or an intake worksheet from a reviewed original.',
    ['agreement'],
  ],
  calendar: [
    'Calendar studio',
    'Choose a 2027 calendar and personalize its original workbook.',
    ['calendar'],
  ],
  design: [
    'Design studio',
    'Edit a print layout, certificate, or illustration in its original format.',
    ['design'],
  ],
  diagram: [
    'Diagram studio',
    'Adapt a diagram to document a process, relationship, or decision.',
    ['diagram'],
  ],
  form: [
    'Form studio',
    'Start with the fields and sections of an existing form.',
    ['form', 'guided_worksheet', 'checklist', 'worksheet'],
  ],
  planner: [
    'Planner studio',
    'Build a schedule from a dated planner or tracking sheet.',
    ['calendar', 'tracker'],
  ],
  presentation: [
    'Presentation studio',
    'Revise editable slide content for your audience.',
    ['presentation'],
  ],
  spreadsheet: [
    'Spreadsheet studio',
    'Customize a workbook while retaining its sheets and formulas.',
    ['spreadsheet', 'tracker', 'receipt'],
  ],
};
const { path } = Astro.props,
  kind = path.split('/')[2] || '',
  cfg = familyMap[kind],
  pool = entries.filter(
    (e) =>
      !Astro.locals.held?.has(e.id) &&
      (!cfg || cfg[2].includes(e.builder_kind)),
  );
const requested = Astro.url.searchParams.get('template') || '',
  item =
    pool.find((s) => s.topic_slug === requested) ||
    (!requested && cfg ? pool[0] : null);
const title =
  path === '/studio/review/'
    ? 'Review your document'
    : cfg
      ? cfg[0]
      : 'Document Studio';
---

{item && <ImageLicenseMetadata images={[item]} />}
<div class="breadcrumb">
  <a href="/">Home</a> / <a href="/create/">Create</a> / {title}
</div>
<div class="surface-heading">
  <span class="surface-icon">
    <Icon name={kind === 'design' ? 'pen' : 'studio'} size={24} />
  </span>
  <div>
    <div class="kicker">TemplateAtlas Studio</div>
    <h1>{title}</h1>
  </div>
</div>
<p class="lead">
  {cfg?.[1] ||
    'Choose an original template, fill in its fields, and export your own version.'}
</p>
{item ? (
  <>
    <form class="studio-picker" action={path}>
      <label>
        Choose a template
        <select name="template">
          {pool.map((s) => (
            <option value={s.topic_slug} selected={s.id === item.id}>
              {s.title}
            </option>
          ))}
        </select>
      </label>
      <button>Open template</button>
    </form>
    <div class="workspace">
      <aside class="panel">
        <span class="kicker">Edit the original</span>
        <Customize templateId={item.id} title={item.title} expanded={true} />
      </aside>
      <article>
        <h2>{item.title}</h2>
        <p>{item.summary}</p>
        <p class="meta">
          {item.formats.map((f: string) => (
            <span class={'chip chip-' + f}>{f.toUpperCase()}</span>
          ))}
        </p>
        <div class="preview">
          <img
            src={item.preview}
            alt={'Original first page of ' + item.title}
          />
        </div>
        <p>
          <a href={item.detail_path}>View the original template details →</a>
        </p>
      </article>
    </div>
  </>
) : (
  <>
    <div class="grid small studio-modes">
      {[
        [
          'invoice',
          'Invoice builder',
          'Calculate totals from editable line items.',
          'receipt',
        ],
        [
          'chart',
          'Chart Studio',
          'Edit your data and choose a visualization.',
          'chart',
        ],
        ...Object.entries(familyMap).map(([k, v]) => [
          k,
          v[0],
          v[1],
          k === 'design'
            ? 'pen'
            : k === 'calendar'
              ? 'calendar'
              : k === 'agreement'
                ? 'scale'
                : 'layers',
        ]),
      ].map(([slug, t, desc, icon]) => (
        <a class="listlink" href={'/create/' + slug + '/'}>
          <Icon name={icon} size={23} />
          <b>{t}</b>
          <small>{desc}</small>
        </a>
      ))}
    </div>
    {path === '/studio/review/' && (
      <p>
        <a href="/account/documents/">Open saved documents and revisions →</a>
      </p>
    )}
  </>
)}
