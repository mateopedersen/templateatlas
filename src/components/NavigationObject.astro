---
const { kind } = Astro.props;
const id = `nav-object-${crypto.randomUUID()}`;
---
<svg viewBox="0 0 40 40" width="32" height="32" fill="none" aria-hidden="true">
 <defs>
  <linearGradient id={`${id}-wine`} x1="5" y1="4" x2="33" y2="35" gradientUnits="userSpaceOnUse"><stop stop-color="#b87486"/><stop offset=".48" stop-color="#82445c"/><stop offset="1" stop-color="#50243c"/></linearGradient>
  <linearGradient id={`${id}-paper`} x1="4" y1="4" x2="34" y2="33" gradientUnits="userSpaceOnUse"><stop stop-color="#fffdf6"/><stop offset="1" stop-color="#ddcbb8"/></linearGradient>
  <linearGradient id={`${id}-gold`} x1="9" y1="8" x2="30" y2="30" gradientUnits="userSpaceOnUse"><stop stop-color="#fff1cb"/><stop offset=".45" stop-color="#d5ab78"/><stop offset="1" stop-color="#a67852"/></linearGradient>
 </defs>
 {kind === 'categories' ? <>
  <path d="M7 12h18l3 3v18H7z" fill="#b19583" opacity=".3"/>
  <path d="M5 10h20l3 4v18H5z" fill={`url(#${id}-gold)`} stroke="#aa8569" stroke-width=".8"/>
  <path d="M9 7h16v21H9z" fill={`url(#${id}-paper)`} stroke="#bc9f92" stroke-width=".8"/>
  <path d="M13 4h16v22H13z" fill="#fdf9f0" stroke="#c5ac9f" stroke-width=".8"/>
  <path d="M16 9h10M16 13h10M16 17h7" stroke="#bc9b9d" stroke-width="1" stroke-linecap="round"/>
  <path d="M4 20h29l-3 12H7z" fill={`url(#${id}-wine)`} stroke="#6e3b51" stroke-width=".8"/><path d="M8 22h21" stroke="#edb8bb" stroke-opacity=".65"/>
 </> : kind === 'create' ? <>
  <rect x="6" y="6" width="23" height="28" rx="2" fill={`url(#${id}-paper)`} stroke="#bda599"/>
  <path d="M10 13h14M10 17h11M10 21h8M10 25h10" stroke="#c0a9a6" stroke-width="1.1" stroke-linecap="round"/>
  <path d="M16 28 29 9l4 3-13 19-6 3z" fill={`url(#${id}-wine)`} stroke="#693349" stroke-width=".7"/><path d="m29 9 2-3 4 3-2 3z" fill={`url(#${id}-gold)`}/><path d="m16 28 4 3-6 3z" fill="#d9bb99"/><path d="m14 34 2-4 1 2z" fill="#493a39"/>
 </> : kind === 'tools' ? <>
  <rect x="6" y="8" width="27" height="24" rx="3" fill={`url(#${id}-wine)`} stroke="#66364b"/>
  <path d="M7 12h25M7 29h25" stroke="#e8b3b7" stroke-opacity=".55"/>
  <circle cx="19.5" cy="20" r="7" fill={`url(#${id}-gold)`} stroke="#a9825f"/><circle cx="19.5" cy="20" r="4.5" fill="#fff8e9"/>
  <path d="M19.5 16v1.3M16 20h1.3m4.4 0H23M19.5 20l2.8-2.3" stroke="#825b58" stroke-width="1" stroke-linecap="round"/><circle cx="19.5" cy="20" r="1" fill="#82465a"/>
 </> : <>
  <path d="M6 9c5-2 10-1 14 2 4-3 9-4 14-2v21c-5-2-10-1-14 2-4-3-9-4-14-2z" fill={`url(#${id}-paper)`} stroke="#b79c8a"/>
  <path d="M20 11v20" stroke="#c2a795"/><path d="M9 14c3-1 6 0 8 1m-8 3c3-1 6 0 8 1" stroke="#ae9491" stroke-linecap="round"/>
  <circle cx="27" cy="18" r="5.5" fill={`url(#${id}-wine)`}/><path d="M25.6 16.7c.1-1 2.8-1.3 2.8.2 0 1-1.4 1.2-1.4 2.1m0 2h.1" stroke="#fff" stroke-width="1.2" stroke-linecap="round"/>
 </>}
</svg>
