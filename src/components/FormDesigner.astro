<section class="form-designer">
  <p class="eyebrow">TemplateAtlas / Create</p>
  <h1>Form Studio</h1>
  <p class="intro">
    Build a form for print or digital completion. Add questions on the left and
    review their order on the right.
  </p>
  <div class="form-layout">
    <div class="form-controls">
      <h2>Design your form</h2>
      <label>
        Form title
        <input data-form-title maxlength="100" />
      </label>
      <label>
        Instructions
        <textarea data-form-desc maxlength="320" rows="2"></textarea>
      </label>
      <div class="form-section">
        <h3>Questions</h3>
        <p>
          Use Move up and Move down to change the order. You can also focus a
          question and press Alt + ↑ or Alt + ↓.
        </p>
      </div>
      <div data-form-fields></div>
      <div class="form-add">
        <label>
          New field type
          <select data-new-field>
            <option value="short">Short answer</option>
            <option value="long">Long answer</option>
            <option value="date">Date</option>
            <option value="number">Number</option>
            <option value="choice">Choose one</option>
            <option value="checkbox">Checkbox</option>
          </select>
        </label>
        <button type="button" data-add-field>
          Add field
        </button>
      </div>
    </div>
    <div class="form-output">
      <h2>Print preview</h2>
      <p>
        Asterisks mark required questions. The PDF has fillable fields and also
        prints on US Letter paper.
      </p>
      <article data-form-preview aria-label="Form content preview"></article>
      <div class="form-actions">
        <button type="button" data-save-form>
          Save draft
        </button>
        <button type="button" data-export-form="docx">
          Download Word
        </button>
        <button type="button" data-export-form="pdf">
          Download fillable PDF
        </button>
      </div>
      <a data-new-form href="/create/form/">
        Start another form
      </a>
      <p data-form-state role="status" aria-live="polite"></p>
      <p data-form-gate hidden>
        <a href="/signup/">Create an account</a> ·{' '}
        <a href="/pricing/">View membership</a>
      </p>
    </div>
  </div>
  <noscript>Enable JavaScript to design and export a form.</noscript>
</section>
<script>
  import '../forms/client.mjs';
</script>
