---
const { kind } = Astro.props;
const id = `workbench-${crypto.randomUUID()}`;
const icons: Record<string, string> = {
  chart: 'chart', invoice: 'invoice', form: 'form', calendar: 'calendar', planner: 'planner', agreement: 'agreement', design: 'design', diagram: 'diagram', spreadsheet: 'spreadsheet', presentation: 'presentation',
  'aspect-ratio-calculator': 'ratio', 'grade-calculator': 'grade', 'hex-to-decimal-converter': 'hex', 'weeks-in-year': 'week', 'calendar-2027': 'calendar', 'ppi-calculator': 'screen', 'schedule-maker': 'planner', 'significant-figures-calculator': 'decimal', 'venn-diagram-maker': 'venn',
};
const type = icons[kind] || 'form';
---
<svg viewBox="0 0 48 48" width="42" height="42" fill="none" aria-hidden="true">
 <defs>
  <linearGradient id={`${id}-paper`} x1="9" y1="3" x2="36" y2="41" gradientUnits="userSpaceOnUse"><stop stop-color="#fffefa"/><stop offset="1" stop-color="#e6d6c6"/></linearGradient>
  <linearGradient id={`${id}-wine`} x1="11" y1="9" x2="35" y2="36" gradientUnits="userSpaceOnUse"><stop stop-color="#b87787"/><stop offset="1" stop-color="#632c45"/></linearGradient>
  <linearGradient id={`${id}-gold`} x1="8" y1="5" x2="37" y2="35" gradientUnits="userSpaceOnUse"><stop stop-color="#f9e6bd"/><stop offset="1" stop-color="#bf9268"/></linearGradient>
 </defs>
 <path d="M10 8 34 6l4 29-24 4z" fill="#a78d7d" opacity=".3"/>
 <path d="M8 5h25l5 5v27H8z" fill={`url(#${id}-paper)`} stroke="#c5aa9a"/>
 <path d="M33 5v5h5" stroke="#c5aa9a"/>
 {type === 'chart' || type === 'grade' ? <><path d="M13 31h19M13 31V14" stroke="#bba89c"/><rect x="16" y="23" width="4" height="8" rx="1" fill="#c3938b"/><rect x="22" y="18" width="4" height="13" rx="1" fill="#aa7081"/><rect x="28" y="13" width="4" height="18" rx="1" fill={`url(#${id}-wine)`}/></> :
 type === 'calendar' || type === 'week' ? <><rect x="12" y="12" width="22" height="20" rx="2" fill="#fffdf6" stroke="#bb9c8a"/><path d="M12 17h22" stroke={`url(#${id}-wine)`} stroke-width="5"/><path d="M17 10v4m12-4v4" stroke="#9c795d" stroke-width="2" stroke-linecap="round"/><path d="M16 22h3m3 0h3m3 0h3m-15 5h3m3 0h3m3 0h3" stroke="#bba69b" stroke-width="1.5" stroke-linecap="round"/></> :
 type === 'invoice' ? <><rect x="12" y="11" width="20" height="4" rx="1" fill={`url(#${id}-wine)`}/><path d="M12 19h20M12 23h20M12 27h20" stroke="#b99f96"/><path d="M25 19v8" stroke="#b99f96"/><text x="12" y="34" fill="#7a4056" font-size="6" font-family="sans-serif" font-weight="bold">$</text><path d="M20 33h12" stroke="#b99f96"/></> :
 type === 'planner' || type === 'form' ? <><rect x="12" y="12" width="4" height="4" rx=".5" stroke="#9a6f72"/><rect x="12" y="20" width="4" height="4" rx=".5" stroke="#9a6f72"/><rect x="12" y="28" width="4" height="4" rx=".5" stroke="#9a6f72"/><path d="M19 14h12M19 22h12M19 30h9" stroke="#a88d88" stroke-width="1.5" stroke-linecap="round"/></> :
 type === 'agreement' ? <><path d="M12 13h21M12 17h21M12 21h18" stroke="#ae9991"/><path d="M13 30c3-6 3 3 6-2s1 3 5 0 4 1 7-1" stroke="#82445a" stroke-width="1.4" stroke-linecap="round"/></> :
 type === 'spreadsheet' ? <><rect x="12" y="11" width="21" height="22" fill="#fffdf7" stroke="#a9958b"/><path d="M12 17h21M12 22h21M12 27h21M19 11v22M26 11v22" stroke="#bca99e"/><path d="M12 11h21v6H12z" fill="#8c5266"/></> :
 type === 'diagram' || type === 'venn' ? <><circle cx="19" cy="22" r="7" fill="#d7a6a5" fill-opacity=".7" stroke="#9d6771"/><circle cx="27" cy="22" r="7" fill="#e4c48c" fill-opacity=".6" stroke="#b48b65"/></> :
 type === 'presentation' || type === 'screen' ? <><rect x="11" y="12" width="24" height="17" rx="1.5" fill="#f7eee6" stroke="#9f7f78"/><path d="M11 16h24" stroke="#925c69" stroke-width="3"/><path d="M16 25h3v-4h-3zm5 0h3v-6h-3zm5 0h3v-8h-3z" fill="#b37685"/><path d="M23 29v4m-5 0h10" stroke="#a28b7d" stroke-linecap="round"/></> :
 type === 'ratio' ? <><rect x="12" y="15" width="21" height="15" rx="1" stroke="#91576b" stroke-width="1.5"/><path d="M15 12h15m-15 0 2-2m-2 2 2 2m13-2-2-2m2 2-2 2M9 18v9m0-9-2 2m2-2 2 2m-2 7-2-2m2 2 2-2" stroke="#b99772" stroke-linecap="round" stroke-linejoin="round"/></> :
 type === 'hex' || type === 'decimal' ? <><rect x="11" y="12" width="24" height="18" rx="2" fill="#f2e6d9" stroke="#c4a99a"/><text x="23" y="24" text-anchor="middle" font-family="sans-serif" font-size="7" font-weight="bold" fill="#7a4056">{type === 'hex' ? '0x → 10' : '0.00'}</text></> :
 <><circle cx="19" cy="20" r="5" fill="#d3b2b6"/><circle cx="27" cy="18" r="5" fill={`url(#${id}-gold)`}/><path d="m13 30 7-7 4 3 3-3 6 7z" fill={`url(#${id}-wine)`}/></>}
</svg>
