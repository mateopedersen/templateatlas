<script>
const f=document.querySelector<HTMLFormElement>('.header-search');if(f){const inp=f.querySelector<HTMLInputElement>('input')!;const panel=document.createElement('div');panel.className='suggest';panel.id='global-suggestions';panel.setAttribute('role','listbox');panel.hidden=true;f.append(panel);inp.setAttribute('role','combobox');inp.setAttribute('aria-autocomplete','list');inp.setAttribute('aria-controls',panel.id);inp.setAttribute('aria-expanded','false');
let timer:number,last=0,idx=-1,controller:AbortController|undefined;const close=()=>{panel.hidden=true;idx=-1;inp.setAttribute('aria-expanded','false');inp.removeAttribute('aria-activedescendant');};
function active(n:number){const list=[...panel.querySelectorAll('a')];if(!list.length)return;idx=(n+list.length)%list.length;list.forEach((a,i)=>a.setAttribute('aria-selected',String(i===idx)));inp.setAttribute('aria-activedescendant',list[idx].id);}
inp.addEventListener('input',()=>{clearTimeout(timer);controller?.abort();const seq=++last;close();if(inp.value.trim().length<2)return;timer=window.setTimeout(async()=>{controller=new AbortController();try{const r=await fetch('/api/search?q='+encodeURIComponent(inp.value),{signal:controller.signal});if(!r.ok)return;const j=await r.json();if(seq!==last||document.activeElement!==inp)return;panel.replaceChildren();for(const [i,s] of j.results.slice(0,5).entries()){const a=document.createElement('a');a.href=s.path;a.textContent=s.title;a.id='global-suggest-'+i;a.setAttribute('role','option');panel.append(a);}if(panel.childElementCount){panel.hidden=false;inp.setAttribute('aria-expanded','true');}}catch{}},180);});
inp.addEventListener('keydown',e=>{if(e.key==='Escape'){last++;close();}if(panel.hidden)return;if(e.key==='ArrowDown'||e.key==='ArrowUp'){e.preventDefault();active(idx+(e.key==='ArrowDown'?1:-1));}else if(e.key==='Enter'&&idx>=0){e.preventDefault();panel.querySelectorAll('a')[idx]?.click();}});f.addEventListener('focusout',e=>{if(!f.contains(e.relatedTarget as Node))close();});}
</script>
