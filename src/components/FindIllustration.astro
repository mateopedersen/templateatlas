---
const { topic = '', kind = '', preview = '' } = Astro.props;
const isGauge = /r134a|refrigerant|pressure-temperature/i.test(topic + ' ' + kind);
const isCalendar = /calendar|planner|schedule/i.test(topic + ' ' + kind);
const isChart = /chart|graph|diagram/i.test(topic + ' ' + kind);
const uid = 'find-' + crypto.randomUUID();
const showPreview = Boolean(preview) && !isGauge;
---
<svg viewBox="0 0 80 80" width="68" height="68" aria-hidden="true" fill="none">
 <defs>
  <linearGradient id={`${uid}-page`} x1="8" y1="4" x2="53" y2="65" gradientUnits="userSpaceOnUse"><stop stop-color="#fff"/><stop offset="1" stop-color="#e7ddd5"/></linearGradient>
  <linearGradient id={`${uid}-metal`} x1="19" y1="12" x2="57" y2="58" gradientUnits="userSpaceOnUse"><stop stop-color="#faf9f6"/><stop offset=".32" stop-color="#a9a9a8"/><stop offset=".52" stop-color="#f7f7f4"/><stop offset="1" stop-color="#6b696d"/></linearGradient>
  <linearGradient id={`${uid}-glass`} x1="44" y1="40" x2="73" y2="72" gradientUnits="userSpaceOnUse"><stop stop-color="#b87990"/><stop offset=".5" stop-color="#6a3049"/><stop offset="1" stop-color="#3d192d"/></linearGradient>
  <linearGradient id={`${uid}-cylinder`} x1="20" y1="0" x2="39" y2="0" gradientUnits="userSpaceOnUse"><stop stop-color="#165e60"/><stop offset=".23" stop-color="#3f9a98"/><stop offset=".48" stop-color="#8bd4ca"/><stop offset=".72" stop-color="#4fa9a0"/><stop offset="1" stop-color="#175a60"/></linearGradient>
  <linearGradient id={`${uid}-rim`} x1="0" y1="15" x2="0" y2="35" gradientUnits="userSpaceOnUse"><stop stop-color="#f4f5f3"/><stop offset=".42" stop-color="#777b80"/><stop offset=".72" stop-color="#edece8"/><stop offset="1" stop-color="#575961"/></linearGradient>
  <clipPath id={`${uid}-preview-clip`}><rect x="19" y="15" width="38" height="44" rx="2"/></clipPath>
  <filter id={`${uid}-shadow`} x="0" y="0" width="80" height="80" filterUnits="userSpaceOnUse"><feGaussianBlur stdDeviation="2.4"/></filter>
 </defs>
 <ellipse cx="37" cy="67" rx="27" ry="5" fill="#421e30" opacity=".16" filter={`url(#${uid}-shadow)`}/>
 <path d="M15 12c0-3 2-5 5-5h32l9 9v43c0 3-2 5-5 5H20c-3 0-5-2-5-5z" fill={`url(#${uid}-page)`} stroke="#c6b7b7"/>
 <path d="M52 7v9h9" fill="#f8f4ef" stroke="#c6b7b7"/>
 {showPreview ? <>
   <rect x="19" y="15" width="38" height="44" rx="2" fill="#fff" stroke="#dfd5d2"/>
   <image href={preview} x="19" y="15" width="38" height="44" preserveAspectRatio="xMidYMin slice" clip-path={`url(#${uid}-preview-clip)`}/>
   <rect x="19" y="15" width="38" height="44" rx="2" fill="none" stroke="#aa999e" stroke-opacity=".45"/>
 </> : isGauge ? <>
   <rect x="20" y="14" width="36" height="5" rx="1.5" fill="#72384d"/>
   <path d="M41 26h14M41 30h14M41 34h14M41 38h14M41 42h14M41 46h14M41 50h14M41 54h14M45 24v32M50 24v32" stroke="#b5a7a8" stroke-width=".7"/>
   <rect x="41" y="22" width="14" height="3" rx=".8" fill="#8b5a6a"/>
   <ellipse cx="30" cy="56" rx="10" ry="2.3" fill="#3d2431" opacity=".17"/>
   <path d="M21.5 32c0-4 2.7-6.5 5.5-7.6v-2.2h6v2.2c3 1.1 5.5 3.6 5.5 7.6v19c0 3-3.8 4.8-8.5 4.8s-8.5-1.8-8.5-4.8z" fill={`url(#${uid}-cylinder)`} stroke="#22666a" stroke-width=".7"/>
   <path d="M26 24v-3.8h8V24" fill="#4b9695" stroke="#22666a" stroke-width=".7"/><path d="M28 20v-3h4v3" fill={`url(#${uid}-metal)`} stroke="#69777a" stroke-width=".6"/><path d="M25 17h10" stroke="#8b9292" stroke-width="1.8" stroke-linecap="round"/>
   <path d="M24 33c1.5 1.3 10.5 1.3 12 0v13c-1.5 1-10.5 1-12 0z" fill="#f8f6ec" stroke="#b8ceca" stroke-width=".5"/><text x="30" y="39" fill="#345f61" font-size="3.3" font-family="Arial,sans-serif" font-weight="bold" text-anchor="middle">R134a</text><path d="M27 42h6m-5 2h4" stroke="#89a7a3" stroke-width=".7"/>
   <path d="M23.3 30v20" stroke="#c6f4ed" stroke-width="1" opacity=".6" stroke-linecap="round"/>
 </> : isCalendar ? <>
   <rect x="21" y="19" width="33" height="34" rx="3" fill="#fff" stroke="#b79ea8"/><path d="M21 28h33" stroke="#a46c7e" stroke-width="5"/><path d="M27 17v5m21-5v5" stroke="#714158" stroke-width="2" stroke-linecap="round"/><path d="M27 34h4m5 0h4m5 0h4M27 40h4m5 0h4m5 0h4M27 46h4m5 0h4m5 0h4" stroke="#b9a9ae" stroke-width="2" stroke-linecap="round"/>
 </> : isChart ? <>
   <path d="M23 51V21M23 51h29" stroke="#a5979d" stroke-linecap="round"/><rect x="27" y="38" width="5" height="13" rx="1" fill="#c3909f"/><rect x="35" y="31" width="5" height="20" rx="1" fill="#a56c82"/><rect x="43" y="24" width="5" height="27" rx="1" fill="#753750"/><path d="m27 34 10-7 9-7" stroke="#bf8e65" stroke-width="1.5"/>
 </> : <>
   <rect x="22" y="19" width="27" height="5" rx="2" fill="#783f56"/><path d="M22 31h30M22 37h25M22 43h28M22 49h18" stroke="#bdaab0" stroke-width="2" stroke-linecap="round"/>
 </>}
 <circle cx="53" cy="51" r="10" fill={`url(#${uid}-rim)`} stroke="#65636a" stroke-width="1.2"/>
 <circle cx="53" cy="51" r="7.3" fill="#45616a" stroke="#45464b" stroke-width=".8"/><circle cx="53" cy="51" r="6" fill="#e5f4f2" stroke="#fcfffe" stroke-width="1"/>
 <path d="M49 48c1-2 3-3 5-3" stroke="#fff" stroke-width="1.5" stroke-linecap="round" opacity=".9"/>
 <path d="m60 58 8 8" stroke="#49233a" stroke-width="5" stroke-linecap="round"/><path d="m61 58 7 7" stroke="#bc8497" stroke-width="1.2" stroke-linecap="round"/>
</svg>
