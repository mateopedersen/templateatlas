---
const { paper, orientation, color, class: className = '' } = Astro.props;
---
<div class:list={['template-properties', className]} aria-label="Template Properties">
  <span class="template-property">
    <span class="property-icon" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><path d="M12 2H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V6Z"/><path d="M12 2v4h4M7 10h6M7 13h4"/></svg></span>
    <span class="property-label">{paper}</span>
  </span>
  <span class="template-property">
    <span class="property-icon" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3"><rect x={orientation === 'Portrait' ? 5 : 2} y={orientation === 'Portrait' ? 2 : 5} width={orientation === 'Portrait' ? 10 : 16} height={orientation === 'Portrait' ? 16 : 10} rx="2"/></svg></span>
    <span class="property-label">{orientation}</span>
  </span>
  <span class="template-property" aria-label={color}>
    <span class="property-icon" aria-hidden="true"><i class:list={['property-swatch', {'is-mono': color === 'Black-and-white'}]}/></span>
    <span class="property-label">{color === 'Black-and-white' ? 'B&W' : color}</span>
  </span>
</div>
