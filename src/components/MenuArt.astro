---
// Image-generated objects in an SVG viewport. The shared PNG is a raster atlas,
// not a vector conversion; each destination selects its reviewed subject.
const { kind } = Astro.props;
const cells: Record<string,number> = {
 'business-commerce':0,'resumes-careers':1,'legal-official-documents':2,'real-estate-rental':3,'construction-maintenance':4,'charts-graphs':5,
 'education-academic':6,'design-creative':7,'music-instruments':8,'planners':9,'monthly':10,'holidays':11,
 'home-lifestyle':12,'health-medical':13,'food-cooking':14,'special-events-occasions':15,'travel-trip-planning':16,'vehicles-transportation':17,
 'sports-recreation':18,'games-entertainment':19,'chart':20,'invoice':21,'form':22,'calendar':23,
 'planner':24,'agreement':25,'design':26,'diagram':27,'spreadsheet':28,'presentation':29,
 'aspect-ratio-calculator':30,'grade-calculator':31,'hex-to-decimal-converter':32,'weeks-in-year':33,'calendar-2027':34,'ppi-calculator':35,
 'schedule-maker':36,'significant-figures-calculator':37,'venn-diagram-maker':38,'categories':39,'create':40,'tools':41,'help':42,'all':43,
 'resume':43,'year':34,
};
const cell = cells[kind] ?? 43;
const x = (cell % 6) * 181, y = Math.floor(cell / 6) * 181;
---
<svg class="menu-object" viewBox={`${x} ${y} 181 181`} width="64" height="64" fill="none" aria-hidden="true" focusable="false" data-menu-art={kind}>
  <image href="/art/menu/object-atlas-v3.webp" width="1086" height="1448"/>
</svg>
