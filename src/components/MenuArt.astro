---
// Small illustrated objects, drawn for the destination rather than generic file icons.
const { kind } = Astro.props;
const map: Record<string,string> = {
 'business-commerce':'business','resumes-careers':'resume','legal-official-documents':'legal','real-estate-rental':'house','construction-maintenance':'construction',
 'charts-graphs':'chart','education-academic':'education','design-creative':'creative','music-instruments':'music','planners':'planner','monthly':'calendar',
 'holidays':'holiday','home-lifestyle':'home','health-medical':'medical','food-cooking':'food','special-events-occasions':'gift','travel-trip-planning':'travel',
 'vehicles-transportation':'vehicle','sports-recreation':'sport','games-entertainment':'games',
 'aspect-ratio-calculator':'ratio','grade-calculator':'grade','hex-to-decimal-converter':'hex','weeks-in-year':'weeks','calendar-2027':'year','ppi-calculator':'pixels',
 'schedule-maker':'schedule','significant-figures-calculator':'figures','venn-diagram-maker':'venn',
};
const type = map[kind] || kind;
const id = `menuart-${crypto.randomUUID()}`;
---
<svg viewBox="0 0 64 64" width="58" height="58" fill="none" aria-hidden="true" focusable="false">
 <defs>
  <linearGradient id={`${id}-paper`} x1="12" y1="6" x2="49" y2="54" gradientUnits="userSpaceOnUse"><stop stop-color="#fff"/><stop offset="1" stop-color="#dce6eb"/></linearGradient>
  <linearGradient id={`${id}-wine`} x1="13" y1="12" x2="50" y2="52" gradientUnits="userSpaceOnUse"><stop stop-color="#a46b82"/><stop offset=".55" stop-color="#713a52"/><stop offset="1" stop-color="#472034"/></linearGradient>
  <linearGradient id={`${id}-metal`} x1="11" y1="8" x2="47" y2="50" gradientUnits="userSpaceOnUse"><stop stop-color="#fff"/><stop offset=".48" stop-color="#b8c6ce"/><stop offset="1" stop-color="#778c99"/></linearGradient>
  <linearGradient id={`${id}-gold`} x1="8" y1="5" x2="48" y2="54" gradientUnits="userSpaceOnUse"><stop stop-color="#f3dcbc"/><stop offset="1" stop-color="#b98a66"/></linearGradient>
  <filter id={`${id}-shadow`} x="-30%" y="-30%" width="160%" height="170%"><feGaussianBlur stdDeviation="2"/></filter>
 </defs>
 <ellipse cx="32" cy="54" rx="21" ry="4" fill="#30404c" opacity=".15" filter={`url(#${id}-shadow)`}/>
 {type==='categories' ? <><path d="M12 20h17l4 5h19l-4 23H15z" fill={`url(#${id}-wine)`} stroke="#512337"/><path d="M19 13h25v17H19z" fill={`url(#${id}-paper)`} stroke="#9aadb8"/><path d="M23 18h17M23 22h14" stroke="#a9bac2" stroke-width="2"/><path d="M12 28h40l-4 20H15z" fill={`url(#${id}-wine)`}/><path d="M18 32h28" stroke="#d4aabb" stroke-opacity=".6"/></> :
 type==='create' ? <><path d="M15 10h24l8 8v32H15z" fill={`url(#${id}-paper)`} stroke="#9baeb8"/><path d="M20 22h18M20 28h14M20 34h10" stroke="#afc0c8" stroke-width="2"/><path d="m31 42 15-21 6 4-15 21-8 3z" fill={`url(#${id}-wine)`} stroke="#5f3446"/><path d="m46 21 3-4 6 4-3 4" fill={`url(#${id}-gold)`}/><path d="m31 42-2 7 6-3" fill="#ddbea2"/></> :
 type==='tools' ? <><path d="M24 21v-5a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v5" stroke="#876a75" stroke-width="3"/><rect x="11" y="20" width="42" height="29" rx="5" fill={`url(#${id}-wine)`} stroke="#512337"/><path d="M12 29h40" stroke="#d7acbd"/><rect x="27" y="27" width="10" height="7" rx="2" fill={`url(#${id}-metal)`}/><path d="M18 39h8m12 0h8" stroke="#cd9bac" stroke-width="1.5"/></> :
 type==='help' ? <><path d="M32 20c-7-7-15-7-22-4v28c8-3 15-3 22 3 7-6 14-6 22-3V16c-7-3-15-3-22 4Z" fill={`url(#${id}-paper)`} stroke="#9cabb5"/><path d="M32 20v27M14 22c6-2 10-1 14 2m8 0c4-3 8-4 14-2" stroke="#a9b9c1"/><circle cx="44" cy="29" r="9" fill={`url(#${id}-wine)`}/><text x="44" y="33" text-anchor="middle" fill="#fff" font-family="Arial,sans-serif" font-size="12" font-weight="bold">?</text></> :
 ['business','travel'].includes(type) ? <>
  <path d="M23 22v-5a5 5 0 0 1 5-5h8a5 5 0 0 1 5 5v5" stroke="#765663" stroke-width="3"/>
  <rect x="12" y="21" width="40" height="29" rx="5" fill={`url(#${id}-wine)`} stroke="#512337"/><path d="M13 29h38" stroke="#d6a6b6" stroke-opacity=".7"/><rect x="28" y="27" width="8" height="7" rx="1.5" fill={`url(#${id}-gold)`}/>{type==='travel' && <><path d="M17 24v23M47 24v23" stroke="#d8baba" stroke-opacity=".55"/><circle cx="21" cy="44" r="2" fill="#efd5b6"/></>}
 </> : ['resume','legal','agreement','invoice','form'].includes(type) ? <>
  <path d="M17 9h24l7 7v34H17z" fill="#b6c5cc"/><path d="M14 7h24l7 7v34H14z" fill={`url(#${id}-paper)`} stroke="#9baeb8"/><path d="M38 7v7h7" stroke="#a0b3bd"/>
  {type==='resume' ? <><circle cx="23" cy="21" r="4" fill={`url(#${id}-wine)`}/><path d="M17 31c1-5 11-5 12 0" fill="#aa7a8a"/><path d="M31 20h9M31 25h9M18 38h21" stroke="#a9bac3" stroke-width="2"/></> : type==='legal' ? <><path d="M29 17v19m-10-12h20M21 24l-5 9h10zm16 0-5 9h10zM22 39h14" stroke="#854e63" stroke-width="2" stroke-linejoin="round"/></> : type==='agreement' ? <><path d="M20 19h18M20 24h18M20 29h14" stroke="#a8b8bf" stroke-width="2"/><path d="M21 38c3-7 3 4 7-1s3 3 7-1" stroke="#713a52" stroke-width="2" stroke-linecap="round"/></> : type==='invoice' ? <><path d="M20 18h19M20 24h19M20 30h19" stroke="#a7b7bf" stroke-width="1.5"/><text x="23" y="42" fill="#713a52" font-size="12" font-weight="bold">$</text><path d="M31 39h8" stroke="#a7b7bf" stroke-width="2"/></> : <><path d="M20 19h4v4h-4zm0 9h4v4h-4zm0 9h4v4h-4z" stroke="#854e63"/><path d="M28 21h11M28 30h11M28 39h8" stroke="#a7b7bf" stroke-width="2"/></>}
 </> : ['house','home'].includes(type) ? <><path d="M9 31 31 13l23 18-4 4-4-3v17H17V32l-4 3z" fill={`url(#${id}-paper)`} stroke="#9aabb5"/><path d="m10 31 21-18 23 18-3 4-20-16-18 16z" fill={`url(#${id}-wine)`}/><rect x="28" y="34" width="9" height="15" rx="1" fill="#805368"/><path d="M20 31h5v6h-5zm20 0h5v6h-5z" fill="#c5dce5" stroke="#9aacb5"/>{type==='home' && <path d="M48 42c1-5 7-5 7 0 0 3-4 6-4 6s-4-3-4-6Z" fill="#a65e79"/>}</> :
 type==='construction' ? <><path d="m14 40 18-18 7 7-18 18-9 3z" fill={`url(#${id}-metal)`} stroke="#8194a0"/><path d="m31 18 5-5 13 13-5 5z" fill={`url(#${id}-wine)`}/><path d="M17 44 34 27" stroke="#fff" stroke-opacity=".8"/><path d="M12 50h39" stroke="#adbdc5" stroke-width="2"/></> :
 ['chart','grade'].includes(type) ? <><path d="M13 45h38M14 44V14" stroke="#9eafb9" stroke-width="2"/><rect x="19" y="32" width="7" height="13" rx="2" fill="#c6a1aa"/><rect x="29" y="25" width="7" height="20" rx="2" fill="#a77488"/><rect x="39" y="16" width="7" height="29" rx="2" fill={`url(#${id}-wine)`}/>{type==='grade' && <><circle cx="47" cy="18" r="10" fill={`url(#${id}-paper)`} stroke="#9baeb8"/><path d="m42 18 3 3 5-6" stroke="#77354f" stroke-width="2.4" stroke-linecap="round"/></>}</> :
 type==='education' ? <><path d="M32 19c-7-7-15-7-22-4v29c8-3 15-3 22 3 7-6 14-6 22-3V15c-7-3-15-3-22 4Z" fill={`url(#${id}-paper)`} stroke="#9cabb5"/><path d="M32 19v28M14 21c6-2 10-1 14 2m8 0c4-3 8-4 14-2" stroke="#a9b9c1"/><path d="M13 12 32 6l19 6-19 6z" fill={`url(#${id}-wine)`}/></> :
 ['creative','design'].includes(type) ? <><path d="M14 37c-3-12 6-23 19-23 12 0 20 8 19 17-.3 5-5 7-9 5-3-1-5 0-5 3 0 7-8 9-15 6-4-2-7-4-9-8Z" fill={`url(#${id}-paper)`} stroke="#9aadb8"/><circle cx="22" cy="25" r="3" fill="#b5768d"/><circle cx="31" cy="20" r="3" fill="#d2a47d"/><circle cx="40" cy="24" r="3" fill="#799cad"/><path d="m38 41 12-14 3 3-12 14-5 2z" fill={`url(#${id}-wine)`}/></> :
 type==='music' ? <><path d="M28 13v29c0 5-5 8-10 6-5-2-4-8 1-10 2-1 5-1 7 0V17l22-5v24c0 5-5 8-10 6-5-2-4-8 1-10 2-1 5-1 7 0V11z" fill={`url(#${id}-wine)`} stroke="#51253b"/><path d="m28 18 18-4" stroke="#e0b6c4" stroke-width="2"/></> :
 ['calendar','weeks','year'].includes(type) ? <><rect x="11" y="15" width="42" height="35" rx="4" fill={`url(#${id}-paper)`} stroke="#9caeb9"/><path d="M12 19a4 4 0 0 1 4-4h32a4 4 0 0 1 4 4v6H12z" fill={`url(#${id}-wine)`}/><path d="M21 10v10m22-10v10" stroke="#b89779" stroke-width="3" stroke-linecap="round"/><path d="M19 31h5m4 0h5m4 0h5M19 38h5m4 0h5m4 0h5" stroke="#a9bac2" stroke-width="2"/>{type==='year' && <text x="32" y="47" text-anchor="middle" fill="#713a52" font-size="8" font-weight="bold">2027</text>}{type==='weeks' && <circle cx="40" cy="38" r="4" fill="#b7768a" opacity=".6"/>}</> :
 ['planner','schedule'].includes(type) ? <><rect x="14" y="10" width="34" height="41" rx="4" fill={`url(#${id}-paper)`} stroke="#9baeb8"/><path d="M19 10v41" stroke="#9e7283" stroke-width="3"/><path d="M25 20h17M25 27h17M25 34h12" stroke="#a4b5bd" stroke-width="2"/>{type==='schedule' && <><circle cx="45" cy="42" r="10" fill={`url(#${id}-wine)`} stroke="#fff" stroke-width="2"/><path d="M45 36v6l4 2" stroke="#fff" stroke-width="1.5" stroke-linecap="round"/></>}</> :
 ['holiday','gift'].includes(type) ? <><rect x="13" y="27" width="38" height="23" rx="3" fill={`url(#${id}-paper)`} stroke="#a0b0b7"/><rect x="11" y="23" width="42" height="7" rx="2" fill={`url(#${id}-wine)`}/><path d="M32 24v26" stroke="#a97586" stroke-width="5"/><path d="M32 22c-3-11-13-10-12-4 1 4 7 5 12 4Zm0 0c3-11 13-10 12-4-1 4-7 5-12 4Z" fill="#d9b7a4" stroke="#99677a"/></> :
 type==='medical' ? <><path d="M23 20v-4a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v4" stroke="#9a7782" stroke-width="3"/><rect x="11" y="20" width="42" height="30" rx="5" fill={`url(#${id}-paper)`} stroke="#9aadb8"/><path d="M28 27h8v6h6v8h-6v6h-8v-6h-6v-8h6z" fill={`url(#${id}-wine)`}/></> :
 type==='food' ? <><path d="M15 26h32l-3 18a6 6 0 0 1-6 5H24a6 6 0 0 1-6-5z" fill={`url(#${id}-metal)`} stroke="#8298a4"/><path d="M14 28H8m39 0h9M20 23h22" stroke="#713a52" stroke-width="3" stroke-linecap="round"/><path d="M24 20c-4-5 4-6 0-11m9 11c-4-5 4-6 0-11m9 11c-4-5 4-6 0-11" stroke="#adbfc6" stroke-width="1.5"/></> :
 type==='vehicle' ? <><path d="m12 36 5-13a6 6 0 0 1 5-4h20a6 6 0 0 1 5 4l5 13v10H12z" fill={`url(#${id}-wine)`} stroke="#51253b"/><path d="m20 26-3 8h30l-3-8a3 3 0 0 0-3-2H23a3 3 0 0 0-3 2Z" fill="#d8e9ee"/><circle cx="20" cy="46" r="5" fill="#3f4850"/><circle cx="44" cy="46" r="5" fill="#3f4850"/><path d="M15 39h5m24 0h5" stroke="#f5ddaf" stroke-width="3" stroke-linecap="round"/></> :
 type==='sport' ? <><circle cx="32" cy="31" r="21" fill={`url(#${id}-paper)`} stroke="#9caeb9"/><path d="m32 22-7 5 3 8h8l3-8zM32 22V11m-7 16-10-3m13 11-6 13m14-13 6 13m-3-21 10-3" stroke="#775165" stroke-width="2" stroke-linejoin="round"/></> :
 type==='games' ? <><rect x="14" y="13" width="35" height="35" rx="6" transform="rotate(-8 31 31)" fill={`url(#${id}-paper)`} stroke="#9baeb8"/><circle cx="23" cy="23" r="2.6" fill="#713a52"/><circle cx="38" cy="21" r="2.6" fill="#713a52"/><circle cx="31" cy="31" r="2.6" fill="#713a52"/><circle cx="23" cy="40" r="2.6" fill="#713a52"/><circle cx="39" cy="38" r="2.6" fill="#713a52"/></> :
 ['diagram','venn'].includes(type) ? <>{type==='venn' ? <><circle cx="25" cy="31" r="14" fill="#bb8195" fill-opacity=".65" stroke="#805066"/><circle cx="39" cy="31" r="14" fill="#a4c0cb" fill-opacity=".65" stroke="#7996a4"/></> : <><path d="M31 19v10M19 40l12-11 13 11" stroke="#9eafb9" stroke-width="2"/><rect x="23" y="9" width="17" height="11" rx="3" fill={`url(#${id}-wine)`}/><rect x="9" y="39" width="20" height="11" rx="3" fill={`url(#${id}-paper)`} stroke="#a0b1b9"/><rect x="36" y="39" width="20" height="11" rx="3" fill={`url(#${id}-paper)`} stroke="#a0b1b9"/></>}</> :
 type==='spreadsheet' ? <><rect x="12" y="10" width="40" height="41" rx="3" fill={`url(#${id}-paper)`} stroke="#9cabb5"/><path d="M12 14a4 4 0 0 1 4-4h32a4 4 0 0 1 4 4v7H12z" fill={`url(#${id}-wine)`}/><path d="M12 28h40M12 36h40M12 44h40M23 21v30m10-30v30m10-30v30" stroke="#b1c1c9"/></> :
 ['presentation','pixels'].includes(type) ? <><rect x="9" y="12" width="46" height="32" rx="4" fill={`url(#${id}-wine)`}/><rect x="12" y="15" width="40" height="26" rx="2" fill={`url(#${id}-paper)`}/>{type==='presentation' ? <><path d="M19 35h4v-8h-4zm8 0h4V23h-4zm8 0h4V19h-4z" fill="#9f6680"/></> : <><path d="M19 20h7v7h-7zm9 0h7v7h-7zm9 0h7v7h-7zm-18 9h7v7h-7zm9 0h7v7h-7zm9 0h7v7h-7z" fill="#9d7285"/></>}<path d="M32 44v6m-9 0h18" stroke="#8b9da8" stroke-width="3" stroke-linecap="round"/></> :
 type==='ratio' ? <><rect x="14" y="19" width="36" height="26" rx="3" fill={`url(#${id}-paper)`} stroke="#9aadb8"/><path d="M20 13h24m-24 0 4-4m-4 4 4 4m20-4-4-4m4 4-4 4M9 24v16m0-16-3 3m3-3 3 3m-3 13-3-3m3 3 3-3" stroke="#824b60" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></> :
 ['hex','figures'].includes(type) ? <><rect x="11" y="15" width="42" height="32" rx="5" fill={`url(#${id}-metal)`} stroke="#879aa5"/><rect x="15" y="19" width="34" height="24" rx="3" fill="#f7fbfd"/><text x="32" y="34" fill="#713a52" text-anchor="middle" font-family="Arial,sans-serif" font-size={type==='hex' ? '8' : '11'} font-weight="bold">{type==='hex' ? '0x → 10' : '0.00'}</text></> :
 <><rect x="13" y="12" width="38" height="39" rx="4" fill={`url(#${id}-paper)`} stroke="#9caeb9"/><path d="M19 21h26M19 28h26M19 35h18" stroke="#a4b7c0" stroke-width="2"/></>}
</svg>
