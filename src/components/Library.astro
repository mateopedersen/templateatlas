---
import facets from '../data/chart-facets.json';
import { env } from 'cloudflare:workers';
import { querySearch } from '../search/query.mjs';
import { tools } from '../lib/tools.mjs';
import {
  categories,
  display,
  categoryItems,
  entries,
  topicEntries,
  search,
} from '../lib/catalog.mjs';
import { types } from '../charts/model.mjs';
import Cards from './Cards.astro';
const useLabels: Record<string, string> = {
  agreement: 'Agreements',
  calendar: 'Calendars',
  checklist: 'Checklists',
  data_chart_editor: 'Data charts',
  design: 'Print designs',
  diagram: 'Diagrams',
  document: 'Documents',
  form: 'Forms',
  guided_worksheet: 'Preparation worksheets',
  invoice: 'Invoices',
  letter: 'Letters',
  presentation: 'Presentations',
  receipt: 'Receipts',
  reference: 'Reference charts',
  resume: 'Résumés and CVs',
  spreadsheet: 'Spreadsheets',
  tracker: 'Trackers',
  worksheet: 'Worksheets',
};
const { path } = Astro.props,
  params = Astro.url.searchParams,
  query = params.get('q') || '',
  format = params.get('format') || '',
  group = params.get('category') || '',
  cat = categories.find((c) => c.path === path),
  chart = path === '/categories/charts-graphs/';
const visibleEntries = entries.filter((e) => !Astro.locals.held?.has(e.id));
const available = (c: any) =>
  categoryItems(c).filter((e) => !Astro.locals.held?.has(e.id));
const searching = path === '/search/';
const browsingTopics = path === '/templates/';
let failure = '',
  indexed: any = null;
if (searching) {
  try {
    indexed = await querySearch((env as any).DB, params);
  } catch (e) {
    failure = (e as Error).message;
    Astro.response.status = (e as any).status || 503;
  }
}
const items = searching
  ? indexed?.results || []
  : cat
    ? available(cat)
    : browsingTopics ? topicEntries(visibleEntries) : visibleEntries;
const goal = params.get('goal') || '',
  validGoal = chart && Object.hasOwn(facets.labels, goal);
const visible = validGoal
  ? items.filter((item: any) => {
      const f = facets.topics[item.id as keyof typeof facets.topics];
      return f?.goals.some((g) => g === goal);
    })
  : items;
const total = searching ? indexed?.total || 0 : visible.length;
const size = 24,
  max = Math.max(1, Math.ceil(total / size)),
  page = searching
    ? indexed?.page || 1
    : Math.min(
        max,
        Math.max(1, Number.parseInt(params.get('page') || '1', 10) || 1),
      ),
  pageLink = (n: number) => {
    let p = new URLSearchParams(params);
    p.set('page', String(n));
    return path + '?' + p;
  };
const n = params.get('page');
if (n && !searching && (!/^\d+$/.test(n) || Number(n) < 1 || Number(n) > max)) {
  Astro.response.status = 404;
  failure = 'This collection page does not exist.';
}
const children = categories.filter(
  (c) =>
    (!chart || ('exact' in c && c.exact)) &&
    c.parent === path &&
    (available(c).length > 0 || c.path === '/categories/calculators/'),
);
const title = chart
  ? 'Charts & Graphs'
  : cat
    ? display(cat.title)
    : path === '/categories/'
      ? 'Collections'
      : path === '/search/'
        ? 'Search the library'
        : 'The template library';
const fmts = [...new Set(visibleEntries.flatMap((s) => s.formats))].sort();
---

<div class="breadcrumb">
  <a href="/">Home</a> / {title}
</div>
<p class="over">The TemplateAtlas catalog</p>
<h1>{title}</h1>
{chart ? (
  <>
    <p class="lead">
      Explore data visualizations, process diagrams, and reference charts. Build
      a chart from your own numbers in Chart Studio.
    </p>
    <a class="button" href="/create/chart/">
      Open Chart Studio →
    </a>
    <nav class="pages" aria-label="Chart goal">
      <a href={path}>All charts</a>
      {Object.entries(facets.labels).map(([k, v]) => (
        <a
          href={path + '?goal=' + k}
          aria-current={goal === k ? 'page' : undefined}
        >
          {v}
        </a>
      ))}
    </nav>
    <details class="narrow">
      <summary>Choose a chart to build</summary>
      <div class="grid small">
        {Object.entries(types).map(([slug, t]) => (
          <a class="listlink" href={'/create/chart/?topic=' + slug}>
            {t.name}
          </a>
        ))}
      </div>
    </details>
  </>
) : null}
{(cat || path === '/categories/') && children.length > 0 && (
  <div class="grid small">
    {children.map((c) => (
      <a class="listlink" href={c.path}>
        <b>{display(c.title)}</b>
        <small>
          {c.path === '/categories/calculators/'
            ? 'Calculation tools'
            : available(c).length + ' templates'}
        </small>
      </a>
    ))}
  </div>
)}
{!cat && path !== '/categories/' && (
  <form action="/search/" class="panel filters">
    <label>
      Search templates
      <input name="q" value={query} placeholder="Search by name or purpose" />
    </label>
    <label>
      File format
      <select name="format">
        <option value="">All formats</option>
        {fmts.map((f) => (
          <option selected={format === f} value={f}>
            {f.toUpperCase()}
          </option>
        ))}
      </select>
    </label>
    <label>
      Collection
      <select name="category">
        <option value="">All collections</option>
        {categories
          .filter((c) => available(c).length)
          .map((c) => (
            <option selected={group === c.path} value={c.path}>
              {display(c.title)}
            </option>
          ))}
      </select>
    </label>
    <label>
      Paper
      <select name="paper">
        <option value="">All sizes</option>
        <option value="letter" selected={params.get('paper') === 'letter'}>
          US Letter
        </option>
        <option value="other" selected={params.get('paper') === 'other'}>
          Other original sizes
        </option>
      </select>
    </label>
    <label>
      Edition
      <select name="year">
        <option value="">All editions</option>
        <option value="2027" selected={params.get('year') === '2027'}>
          2027
        </option>
      </select>
    </label>
    <label>
      Use
      <select name="use">
        <option value="">All uses</option>
        {Object.entries(useLabels).map(([k, v]) => (
          <option value={k} selected={params.get('use') === k}>
            {v}
          </option>
        ))}
      </select>
    </label>
    <label>
      Sort by
      <select name="sort">
        <option value="">Relevance</option>
        <option value="title" selected={params.get('sort') === 'title'}>
          Title A–Z
        </option>
        <option value="newest" selected={params.get('sort') === 'newest'}>
          Recently added
        </option>
      </select>
    </label>
    <button>Search</button>
  </form>
)}
{path === '/categories/calculators/' && (
  <div class="grid small">
    {Object.entries(tools)
      .filter(
        ([k]) =>
          k.includes('calculator') ||
          k.includes('converter') ||
          k === 'weeks-in-year',
      )
      .map(([k, t]) => (
        <a class="listlink" href={'/tools/' + k + '/'}>
          <b>{t.title}</b>
          <small>{t.intro}</small>
        </a>
      ))}
  </div>
)}
{failure && (
  <p role="alert" class="notice">
    {failure} <a href={Astro.url.pathname + Astro.url.search}>Try again</a>
  </p>
)}
{indexed?.correctedQuery && (
  <p>
    Showing results for <b>{indexed.correctedQuery}</b>.
  </p>
)}
{!failure && path !== '/categories/' && path !== '/categories/calculators/' && (
  <>
    <div class="section-head">
      <h2>
        {cat
          ? 'In this collection'
          : query
            ? 'Results for “' + query + '”'
            : browsingTopics ? 'Browse topics' : 'Browse documents'}
      </h2>
      <span>
        {total.toLocaleString('en-US')} {browsingTopics ? (total === 1 ? 'topic' : 'topics') : (total === 1 ? 'template' : 'templates')}
      </span>
    </div>
    {visible.length ? (
      <Cards
        items={
          searching ? visible : visible.slice((page - 1) * size, page * size)
        }
      />
    ) : (
      <div class="empty">
        <h3>
          {cat
            ? 'This collection is being prepared.'
            : !query && !format && !group
              ? 'Enter a search term or select a filter.'
              : 'No matching templates.'}
        </h3>
        <a href="/templates/">Browse the full library</a>
      </div>
    )}
    {max > 1 && (
      <nav class="pages" aria-label="Result pages">
        {page > 1 && <a href={pageLink(page - 1)}>← Previous</a>}
        <span>
          Page {page} of {max}
        </span>
        {page < max && <a href={pageLink(page + 1)}>Next →</a>}
      </nav>
    )}
  </>
)}
