---
import "../styles/imported-collection.css";
import FileIcon from "./FileIcon.astro";
import TemplateProperties from "./TemplateProperties.astro";
const { collection, item } = Astro.props;
const items = collection.items.filter(
  (e: any) => !Astro.locals.held?.has(e.id),
);
const size = (n: number) => (n / 1024 / 1024).toFixed(2) + " MB";
const options = (key: string) =>
  [...new Set(items.map((e: any) => e[key]))] as string[];
---

<nav class="breadcrumb imported-breadcrumb" aria-label="Breadcrumb">
  <a href="/"><svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"><path d="m2 9 8-7 8 7M4 7.5V18h5v-6h3v6h4V7.5"/></svg>Home</a>
  <svg class="breadcrumb-divider" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg>
  <a href="/templates/">Templates</a>
  <svg class="breadcrumb-divider" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg>
  {item ? <a href={collection.topic_path}>R-134a Charts</a> : <span aria-current="page">R-134a Charts</span>}
  {item && <><svg class="breadcrumb-divider" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg><span aria-current="page">{item.design_label}</span></>}
</nav>
<div class:list={["workspace", "imported-workspace", { "imported-browse": !item }]}>
  <aside class="panel imported-controls">
    {item && <p class="over">Refrigerant reference</p>}
    <div class="chart-filter-heading">
      {!item && <span class="filter-heading-icon" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 40 40" fill="none"><rect x="11" y="6" width="23" height="29" rx="4" transform="rotate(9 22 20)" fill="#ddcbbf"/><rect x="6" y="4" width="24" height="29" rx="4" fill="#fff" stroke="#b395a3"/><rect x="10" y="9" width="16" height="6" rx="2" fill="#78344f"/><path d="M11 20h6m-6 5h6m4-5h4m-4 5h4" stroke="#b89eaa" stroke-width="2" stroke-linecap="round"/></svg></span>}
      <div><h2>{item ? "Download This Chart" : "Find Your Chart"}</h2>{!item && <p>Choose Your Format & Layout</p>}</div>
    </div>
    {item ? (
      <>
        <p>
          {item.paper} · {item.orientation} · {item.color}
        </p>
        <div class="download-set">
          <button data-catalog-download={item.id} data-format="pdf">
            Download PDF <span>{size(item.assets.pdf.bytes)}</span>
          </button>
          <button
            class="secondary-download"
            data-catalog-download={item.id}
            data-format="webp"
          >
            Download Image <span>{size(item.assets.webp.bytes)}</span>
          </button>
          <p role="status" data-download-message></p>
        </div>
        <dl class="imported-facts">
          <dt>Reference grid</dt>
          <dd>{item.range}</dd>
          <dt>Data rows</dt>
          <dd>{item.rows}</dd>
          <dt>Units</dt>
          <dd>{item.units.join(" · ")}</dd>
          <dt>Image dimensions</dt>
          <dd>{item.pixels.join(" × ")} px</dd>
          <dt>PDF length</dt>
          <dd>1 page</dd>
        </dl>
        <a href={collection.topic_path}>Browse all 100 charts →</a>
      </>
    ) : (
      <>
        <div class="chart-filter-toolbar">
          <p data-chart-count role="status">{items.length} Charts</p>
          <button type="reset" form="chart-filters" class="chart-filter-reset" disabled>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 10a8 8 0 1 1 1 8M4 4v6h6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Clear All
          </button>
        </div>
        <form id="chart-filters" data-chart-filters>
          {(["edition", "paper", "orientation", "color"] as const).map(
            (key) => (
              <fieldset class="chart-filter-group">
                <legend>{ {edition: "Data edition", paper: "Paper size", orientation: "Orientation", color: "Color style"}[key] }</legend>
                {key === "edition" ? (
                  <select name={key} aria-label="Data edition">
                    <option value="">All editions</option>
                    {options(key).map(value => <option>{value}</option>)}
                  </select>
                ) : (
                  <div class="chart-filter-options">
                    {["", ...options(key)].map(value => (
                      <label class="chart-filter-option">
                        <input type="radio" name={key} value={value} checked={value === ""} />
                        <span>
                          {value === "Portrait" || value === "Landscape" ? <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x={value === "Portrait" ? 5 : 2} y={value === "Portrait" ? 2 : 5} width={value === "Portrait" ? 10 : 16} height={value === "Portrait" ? 16 : 10} rx="2"/></svg> : null}
                          {value === "Color" || value === "Black-and-white" ? <i class:list={["filter-swatch", { "is-mono": value === "Black-and-white" }]} aria-hidden="true" /> : null}
                          {value === "Black-and-white" ? "B&W" : value || "Any"}
                        </span>
                      </label>
                    ))}
                  </div>
                )}
              </fieldset>
            ),
          )}
        </form>
      </>
    )}
    <details class="imported-access">
      <summary>5 Free Template Downloads <span>How It Works</span></summary>
      <ol class="download-access-steps">
        <li><strong>Start Without An Account</strong><p>Download up to five different templates for free.</p></li>
        <li><strong>Both Files Count As One</strong><p>Get the PDF and Image of the same template using just one free selection.</p></li>
        <li><strong>Continue With A Free Trial</strong><p>After five selections, create an account and verify your email to start a 30-day trial. No credit card is required.</p></li>
      </ol>
      <p class="download-access-note">There is no automatic charge. Further downloads after the trial require an active membership. <a href="/help/downloads/">Read The Download Rules</a></p>
    </details>
  </aside>
  <article class="imported-content">
    <p class="over">
      {item ? item.design_label || item.family : "100 printable designs · 5 data editions"}
    </p>
    <h1>{item?.title || collection.title}</h1>
    <p class="lead">{item?.intro || collection.summary}</p>
    {item ? (
      <>
        <section class="imported-description" aria-label="About this template">
          {item.description_paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
        </section>
        <a
          class="imported-large-preview"
          href={item.preview}
          aria-label={"Enlarge preview of " + item.title}
        >
          <img
            src={item.preview}
            alt={item.alt}
            width={item.previewSize[0]}
            height={item.previewSize[1]}
            fetchpriority="high"
          />
        </a>
        <section class="imported-source-note">
          <h2>Using this reference</h2>
          <p>
            The PDF preserves the one-page print layout. The matching Image is a
            full-resolution WebP rendering. These are finished reference sheets
            with fixed data and illustrations.
          </p>
          <p>
            Gauge pressure uses a 101.325 kPa atmospheric reference. Saturation
            values describe the refrigerant relationship; equipment instructions
            determine operating and charging targets.
          </p>
        </section>
        <details>
          <summary>File checksums</summary>
          {item.formats.map((f: string) => (
            <p>
              {f.toUpperCase()} SHA-256
              <br />
              <code class="break-hash">{item.assets[f].sha256}</code>
            </p>
          ))}
        </details>
      </>
    ) : (
      <>
        <details class="imported-collection-note">
          <summary>Which data edition should I choose?</summary>
          <p>
            <strong>Choose the data first.</strong> US Overview uses 5°F steps;
            US Detailed uses 2°F steps. SI Overview uses 2°C steps; SI Detailed
            uses 1°C steps. Pressure Lookup starts with 5-psig intervals.
          </p>
          <p>
            Gauge pressure uses a 101.325 kPa atmospheric reference. Each chart
            keeps its complete reference grid.
          </p>
        </details>
        <div class="imported-grid">
          {items.map((e: any) => (
            <article
              class="imported-card"
              data-chart-card
              data-edition={e.edition}
              data-paper={e.paper}
              data-orientation={e.orientation}
              data-color={e.color}
            >
              <a class="imported-thumb" href={e.detail_path}>
                <img
                  src={e.preview}
                  alt={e.alt}
                  width={e.previewSize[0]}
                  height={e.previewSize[1]}
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <div class="imported-card-body">
                <p class="over">
                  {String(e.number).padStart(3, "0")} / {e.design_label || e.family}
                </p>
                <h2>
                  <a href={e.detail_path}>{e.title}</a>
                </h2>
                <p class="imported-card-summary">{e.intro}</p>
                {e.description_paragraphs.length > 0 && (
                  <details class="imported-card-more">
                    <summary aria-label={"More about " + e.title}>
                      <span class="more-label">More</span>
                      <span class="less-label">Less</span>
                    </summary>
                    {e.description_paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
                  </details>
                )}
                <TemplateProperties class="imported-badges" paper={e.paper} orientation={e.orientation} color={e.color}/>
                <div class="download-set imported-card-downloads">
                  <button
                    data-catalog-download={e.id}
                    data-format="pdf"
                    aria-label={"Download PDF: " + e.title}
                  >
                    <span class="file-button-icon"><FileIcon kind="pdf" /></span>
                    <span class="file-button-copy"><strong>PDF</strong><small>{Math.ceil(e.assets.pdf.bytes / 1024)} KB</small></span>
                    <FileIcon kind="download" class="file-button-arrow" />
                  </button>
                  <button
                    class="secondary-download"
                    data-catalog-download={e.id}
                    data-format="webp"
                    aria-label={"Download Image: " + e.title}
                  >
                    <span class="file-button-icon"><FileIcon kind="image" /></span>
                    <span class="file-button-copy"><strong>Image</strong></span>
                    <FileIcon kind="download" class="file-button-arrow" />
                  </button>
                  <p role="status" data-download-message></p>
                </div>
              </div>
            </article>
          ))}
        </div>
        <p data-empty-charts hidden>
          No charts match these filters. Try another page size or data edition.
        </p>
        <p class="imported-legacy">
          <a href="/templates/r134a-pressure-temperature-chart/r134a-pressure-temperature-chart-essential/">
            View the earlier editable PowerPoint reference →
          </a>
        </p>
      </>
    )}
    <section class="imported-sources">
      <h2>Data, sources, and credits</h2>
      <p>
        This collection uses CoolProp 8.0.0 / HEOS R-134a saturation data. The
        supplied method records comparisons with Arkema and Chemours reference
        tables.
      </p>
      <ul>
        {collection.documents.map((d: any) => (
          <li>
            <a href={d.url}>{d.label}</a>
          </li>
        ))}
        <li>
          <a href="https://coolprop.org/fluid_properties/fluids/R134a.html">
            CoolProp R-134a model documentation
          </a>
        </li>
        <li>
          <a href="https://www.arkema.com/files/live/sites/shared_arkema/files/downloads/products/fluorochemicals/forane-134a-pressure-temperature-chart.pdf">
            Arkema Forane 134a pressure-temperature chart
          </a>
        </li>
        <li>
          <a href="https://www.freon.com/en/-/media/files/freon/freon-134a-si-thermodynamic-properties.pdf?rev=7519d264dfd74fe68c04c9e119f7361f">
            Chemours Freon 134a SI property tables
          </a>
        </li>
      </ul>
    </section>
  </article>
</div>
<script>
  import { download } from "../lib/client.mjs";
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-catalog-download]",
  )) {
    button.addEventListener("click", async () => {
      const group = button.closest(".download-set")!;
      const status = group.querySelector<HTMLElement>(
        "[data-download-message]",
      )!;
      button.disabled = true;
      status.textContent = "Preparing your download…";
      try {
        await download({
          templateId: button.dataset.catalogDownload,
          format: button.dataset.format,
        });
        status.textContent = "Your file has been downloaded.";
      } catch (error) {
        const e = error as Error & { code?: string };
        status.textContent = e.message;
        if (
          [
            "SIGNUP_REQUIRED",
            "EMAIL_VERIFICATION_REQUIRED",
            "MEMBERSHIP_REQUIRED",
          ].includes(e.code || "")
        ) {
          const link = document.createElement("a");
          link.href =
            e.code === "MEMBERSHIP_REQUIRED"
              ? "/pricing/"
              : "/signup/?returnTo=" + encodeURIComponent(location.pathname);
          link.textContent = " Continue";
          status.append(link);
        }
      } finally {
        button.disabled = false;
      }
    });
  }
  const form = document.querySelector<HTMLFormElement>("[data-chart-filters]");
  function filter() {
    if (!form) return;
    const values = new FormData(form);
    let count = 0;
    document
      .querySelectorAll<HTMLElement>("[data-chart-card]")
      .forEach((card) => {
        card.hidden = ["edition", "paper", "orientation", "color"].some(
          (key) => values.get(key) && card.dataset[key] !== values.get(key),
        );
        if (!card.hidden) count++;
      });
    document.querySelector("[data-chart-count]")!.textContent =
      count + " Chart" + (count === 1 ? "" : "s");
    const reset = document.querySelector<HTMLButtonElement>(".chart-filter-reset");
    if (reset) reset.disabled = ![...values.values()].some(Boolean);
    document.querySelector<HTMLElement>("[data-empty-charts]")!.hidden =
      count !== 0;
  }
  form?.addEventListener("change", filter);
  form?.addEventListener("reset", () => setTimeout(filter, 0));
</script>
