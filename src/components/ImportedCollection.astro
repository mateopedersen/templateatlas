---
import "../styles/imported-collection.css";
import TemplateProperties from "./TemplateProperties.astro";
import ImageLicenseMetadata from "./ImageLicenseMetadata.astro";
import HomeIcon from "./HomeIcon.astro";
import ImportedDownloads from "./ImportedDownloads.astro";
import ImportedPreview from "./ImportedPreview.astro";
const { collection, item } = Astro.props;
const weekly = collection.id === "52-week-savings";
const savings = collection.kind === "savings" || collection.id === "100-envelope-savings";
const application = collection.kind === "application";
const petRecord = collection.kind === "pet-record";
const bracket = collection.kind === "bracket";
const label = collection.navigation_label || (weekly ? "52-Week Savings" : savings ? "Savings Trackers" : petRecord ? "Dog Vaccination Record" : "R-134a Charts");
const noun = bracket ? "brackets" : application ? "applications" : savings ? "trackers" : petRecord ? "records" : "charts";
const items = collection.items.filter(
  (e: any) => !Astro.locals.held?.has(e.id),
);
const options = (key: string) =>
  ([...new Set(items.map((e: any) => e[key]))] as string[]).sort((a,b) => bracket && key === "edition" ? parseInt(a) - parseInt(b) : 0);
const featuredPapers = application ? items.slice(0,2) : [
  items.find((entry: any) => entry.orientation === "Landscape"),
  items.find((entry: any) => entry.orientation === "Portrait"),
].filter(Boolean);
---

<ImageLicenseMetadata images={item ? [item] : items} />
<nav class="breadcrumb imported-breadcrumb" aria-label="Breadcrumb">
  <a href="/" class="breadcrumb-home"><HomeIcon /><span>Home</span></a>
  <svg class="breadcrumb-divider" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg>
  <a href="/templates/">Templates</a>
  <svg class="breadcrumb-divider" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg>
  {item ? <a href={collection.topic_path}>{label}</a> : <span aria-current="page">{label}</span>}
  {item && <><svg class="breadcrumb-divider" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg><span aria-current="page">{item.design_label}</span></>}
</nav>
{!item && (
  <section class="print-cover" aria-labelledby="collection-title">
    <div class="print-cover-copy">
      <p>{items.length} Printable Designs <span aria-hidden="true">/</span> {options("edition").length} {bracket ? "Team Counts" : application ? "Application Types" : savings ? "Savings Plans" : petRecord ? "Record Types" : "Data Editions"}</p>
      <h1 id="collection-title">{collection.title}</h1>
      <p class="print-cover-intro">{collection.lead || (savings ? "Choose a savings goal and a printable layout for your challenge." : "Choose a reference sheet for your units, paper size, and print setup.")}</p>
    </div>
    <div class="print-cover-art" aria-hidden="true">
      {featuredPapers.map((sheet: any) => <img src={sheet.preview} width={sheet.previewSize[0]} height={sheet.previewSize[1]} alt="" />)}
    </div>
  </section>
)}
<div class:list={["workspace", "imported-workspace", { "imported-browse": !item }]}>
  <aside class:list={["panel", "imported-controls", {"application-controls":application}]}>
    {item && <p class="over">{bracket ? "Tournament Bracket" : application ? "Commercial Application" : savings ? "Savings tracker" : petRecord ? "Dog vaccination record" : "Refrigerant reference"}</p>}
    {item && <h2>{bracket ? "Download This Bracket" : application ? "Download This Application" : savings ? "Download This Tracker" : petRecord ? "Download This Record" : "Download This Chart"}</h2>}
    {item ? (
      <>
        <p>
          {item.paper} · {item.orientation} · {item.color}
        </p>
        <ImportedDownloads entry={item}/>
        <dl class="imported-facts">
          {!savings && !application && !petRecord && !bracket && <> <dt>Reference grid</dt>
          <dd>{item.range}</dd>
          <dt>Data rows</dt>
          <dd>{item.rows}</dd>
          <dt>Units</dt>
          <dd>{item.units.join(" · ")}</dd>
          </>}
          {savings && <><dt>Savings goal</dt><dd>{"$" + item.goal.toLocaleString("en-US")}</dd></>}
          {application && <><dt>Business Use</dt><dd>{item.subject}</dd><dt>Application Type</dt><dd>{item.editionLabel || item.edition}</dd></>}
          {bracket && <><dt>Participants</dt><dd>{item.teams} Teams</dd><dt>Rounds</dt><dd>{item.rounds}</dd><dt>First-Round Byes</dt><dd>{item.byes}</dd></>}
          {petRecord && <><dt>Record Type</dt><dd>{item.edition}</dd><dt>PDF Form Fields</dt><dd>{item.pdf_fields}</dd><dt>Word Content Controls</dt><dd>{item.docx_controls}</dd></>}
          <dt>Image dimensions</dt>
          <dd>{item.pixels.join(" × ")} px</dd>
          <dt>PDF length</dt>
          <dd>{item.pages} {item.pages===1 ? "page" : "pages"}</dd>
        </dl>
        <a href={collection.topic_path}>Browse all {items.length} {noun} →</a>
      </>
    ) : (
      <>
        <details class="print-filter-drawer" open>
          <summary><span class="finder-title"><span class="finder-title-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span><span><strong>Print options</strong><small>Choose your format</small></span></span></summary>
          <form id="chart-filters" data-chart-filters data-total={items.length}>
            {application && <label class="print-filter-field"><span>Business Use</span><select name="subject"><option value="">All Business Uses</option>{options("subject").sort((a,b)=>a.localeCompare(b,'en-US')).map(value=><option value={value}>{value}</option>)}</select></label>}
            {application ? <fieldset class="layout-picker">
              <legend>Form Length</legend>
              <div class="layout-samples">
                {options("pages").sort((a,b)=>Number(a)-Number(b)).map(pages=>{const example=items.find((entry:any)=>entry.pages===pages);return <label><input type="radio" name="pages" value={String(pages)}/><span class="layout-choice"><span class="layout-proof"><img src={example.preview} alt="" loading="lazy"/></span><span class="layout-name">{pages} {Number(pages)===1?'Page':'Pages'}</span></span></label>;})}
              </div>
              <label class="layout-any"><input type="radio" name="pages" value="" checked/> Any Length</label>
            </fieldset> : <fieldset class="layout-picker">
              <legend>Page layout</legend>
              <div class="layout-samples">
                {options("orientation").map(layout => {
                  const example = items.find((entry: any) => entry.orientation === layout);
                  return <label>
                    <input type="radio" name="orientation" value={layout} />
                    <span class="layout-choice"><span class="layout-proof"><img src={example.preview} alt="" loading="lazy" /></span><span class="layout-name">{layout}</span></span>
                  </label>;
                })}
              </div>
              <label class="layout-any"><input type="radio" name="orientation" value="" checked /> Any layout</label>
            </fieldset>}
            {(["edition", "paper", "color"] as const).filter(key=>!application || key!=="paper" || options("paper").length>1).map(key => (
              <label class="print-filter-field">
                <span>{{edition: bracket ? "Team Count" : application ? "Application Type" : savings ? "Savings plan" : petRecord ? "Record type" : "Data edition", paper: "Paper size", color: "Print style"}[key]}</span>
                <select name={key}>
                  <option value="">{{edition: bracket ? "All Team Counts" : application ? "All Application Types" : savings ? "All savings plans" : petRecord ? "All record types" : "All editions", paper: "All sizes", color: "All styles"}[key]}</option>
                  {options(key).map(value => <option value={value}>{value === "US Letter" ? "US Letter (8.5 × 11 in)" : value === "A4" ? "A4 (210 × 297 mm)" : value === "Tabloid" ? "Tabloid (11 × 17 in)" : value === "ANSI C" ? "ANSI C (17 × 22 in)" : value}</option>)}
                </select>
              </label>
            ))}
          </form>
        </details>
        <div class="finder-results">
          <p role="status" data-chart-count>Showing all {items.length} designs</p>
          <button type="reset" form="chart-filters" class="chart-filter-reset" disabled>Reset filters</button>
        </div>
      </>
    )}
  </aside>
  <article class="imported-content">
    {item && <><p class="over">{item.design_label || item.family}</p><h1>{item.title}</h1><p class="lead">{item.intro}</p></>}
    {item ? (
      <>
        <section class="imported-description" aria-label="About this template">
          {item.description_paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
        </section>
        <ImportedPreview item={item}/>
        {bracket ? <section class="imported-source-note"><h2>Using This Bracket</h2>{collection.usage_paragraphs.map((paragraph:string)=><p>{paragraph}</p>)}</section> : petRecord ? <section class="imported-source-note"><h2>Using This Record</h2>{collection.usage_paragraphs.map((paragraph:string)=><p>{paragraph}</p>)}</section> : application ? <section class="imported-source-note"><h2>Using This Application</h2>{collection.usage_paragraphs.map((paragraph:string)=><p>{paragraph}</p>)}</section> : savings ? <section class="imported-source-note"><h2>Using This Tracker</h2>{weekly ? <><p>Follow the 52 printed weekly amounts. The PDF includes fields for actual deposits, completion checkboxes, and summary information. Word includes editable deposit fields and checkboxes; Excel calculates your goal, saved amount, remaining balance, and progress.</p><p>The Image is a static printable page. The Word and Excel versions use their own editable layouts with the matching plan and artwork.</p></> : <p>The PDF includes 100 checkboxes and three fields for your savings purpose and dates. The Image is a static printable version.</p>}</section> : <section class="imported-source-note">
          <h2>Using this reference</h2>
          <p>
            The PDF preserves the one-page print layout. The matching Image is a
            full-resolution WebP rendering. These are finished reference sheets
            with fixed data and illustrations.
          </p>
          <p>
            Gauge pressure uses a 101.325 kPa atmospheric reference. Saturation
            values describe the refrigerant relationship; equipment instructions
            determine operating and charging targets.
          </p>
        </section>
        }
        <details>
          <summary>File checksums</summary>
          {item.formats.map((f: string) => (
            <p>
              {f.toUpperCase()} SHA-256
              <br />
              <code class="break-hash">{item.assets[f].sha256}</code>
            </p>
          ))}
        </details>
      </>
    ) : (
      <>
        {bracket ? <details class="imported-collection-note"><summary>Which Bracket Should I Choose?</summary>{collection.selection_guide.map((paragraph:string)=><p>{paragraph}</p>)}</details> : petRecord ? <details class="imported-collection-note"><summary>Which Record Type Should I Choose?</summary>{collection.selection_guide.map((paragraph:string)=><p>{paragraph}</p>)}</details> : application ? <details class="imported-collection-note"><summary>Which Application Should I Choose?</summary>{collection.selection_guide.map((paragraph:string)=><p>{paragraph}</p>)}</details> : savings ? <details class="imported-collection-note"><summary>Which Savings Plan Should I Choose?</summary>{weekly ? <><p>Classic increases from $1 to $52; Reverse begins at $52 and decreases to $1. Both total $1,378. Alternating pairs small and large deposits. Fixed plans repeat the same deposit each week.</p><p>Exact $1,000 uses one-cent adjustments in weeks 13, 26, 39, and 52. Cyclic $5,000 follows a varied sequence with adjusted final deposits. Choose a weekly commitment that fits your budget, then record each deposit as it happens.</p></> : <><p>The classic plan uses amounts from $1 to $100 for a $5,050 goal. Equal-deposit plans repeat the same amount 100 times.</p><p>Mark each envelope after saving its amount, in any order and at your own pace.</p></>}</details> : <details class="imported-collection-note">
          <summary>Which data edition should I choose?</summary>
          <p>
            <strong>Choose the data first.</strong> US Overview uses 5°F steps;
            US Detailed uses 2°F steps. SI Overview uses 2°C steps; SI Detailed
            uses 1°C steps. Pressure Lookup starts with 5-psig intervals.
          </p>
          <p>
            Gauge pressure uses a 101.325 kPa atmospheric reference. Each chart
            keeps its complete reference grid.
          </p>
        </details>
        }
        <div class="imported-grid">
          {items.map((e: any) => (
            <article
              class="imported-card"
              data-chart-card
              data-edition={e.edition}
              data-paper={e.paper}
              data-orientation={e.orientation}
              data-color={e.color}
              data-subject={e.subject}
              data-pages={e.pages}
            >
              <a class="imported-thumb" href={e.detail_path}>
                <img
                  src={e.preview}
                  alt={e.alt}
                  width={e.previewSize[0]}
                  height={e.previewSize[1]}
                  loading="lazy"
                  decoding="async"
                />
                {e.pages>1 && <span class="imported-page-count">{e.pages} Pages</span>}
              </a>
              <div class="imported-card-body">
                <p class="over">
                  {String(e.number).padStart(3, "0")} / {e.design_label || e.family}
                </p>
                <h2>
                  <a href={e.detail_path}>{e.title}</a>
                </h2>
                <p class="imported-card-summary">{e.intro}</p>
                {e.description_paragraphs.length > 0 && (
                  <details class="imported-card-more">
                    <summary>
                      <span class="more-label">More</span>
                      <span class="less-label">Less</span>
                      <span class="more-context"> about {e.title}</span>
                    </summary>
                    {e.description_paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
                  </details>
                )}
                <TemplateProperties class="imported-badges" paper={e.paper} orientation={e.orientation} color={e.color}/>
                <ImportedDownloads entry={e}/>
              </div>
            </article>
          ))}
        </div>
        <p data-empty-charts hidden>
          No designs match these filters. Try another option.
        </p>
        {!savings && !application && !petRecord && !bracket && <p class="imported-legacy">
          <a href="/templates/r134a-pressure-temperature-chart/r134a-pressure-temperature-chart-essential/">
            View the earlier editable PowerPoint reference →
          </a>
        </p>}
      </>
    )}
    {!savings && !application && !petRecord && !bracket && <section class="imported-sources">
      <h2>Data, sources, and credits</h2>
      <p>
        This collection uses CoolProp 8.0.0 / HEOS R-134a saturation data. The
        supplied method records comparisons with Arkema and Chemours reference
        tables.
      </p>
      <ul>
        {collection.documents.map((d: any) => (
          <li>
            <a href={d.url}>{d.label}</a>
          </li>
        ))}
        <li>
          <a href="https://coolprop.org/fluid_properties/fluids/R134a.html">
            CoolProp R-134a model documentation
          </a>
        </li>
        <li>
          <a href="https://www.arkema.com/files/live/sites/shared_arkema/files/downloads/products/fluorochemicals/forane-134a-pressure-temperature-chart.pdf">
            Arkema Forane 134a pressure-temperature chart
          </a>
        </li>
        <li>
          <a href="https://www.freon.com/en/-/media/files/freon/freon-134a-si-thermodynamic-properties.pdf?rev=7519d264dfd74fe68c04c9e119f7361f">
            Chemours Freon 134a SI property tables
          </a>
        </li>
      </ul>
    </section>}
  </article>
</div>
<script>
  import { download } from "../lib/client.mjs";
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-catalog-download]",
  )) {
    button.addEventListener("click", async () => {
      const group = button.closest(".download-set")!;
      const status = group.querySelector<HTMLElement>(
        "[data-download-message]",
      )!;
      button.disabled = true;
      status.textContent = "Preparing your download…";
      try {
        await download({
          templateId: button.dataset.catalogDownload,
          format: button.dataset.format,
        });
        status.textContent = "Your file has been downloaded.";
      } catch (error) {
        const e = error as Error & { code?: string };
        status.textContent = e.message;
        if (
          [
            "SIGNUP_REQUIRED",
            "EMAIL_VERIFICATION_REQUIRED",
            "MEMBERSHIP_REQUIRED",
          ].includes(e.code || "")
        ) {
          const link = document.createElement("a");
          link.href =
            e.code === "MEMBERSHIP_REQUIRED"
              ? "/pricing/"
              : "/signup/?returnTo=" + encodeURIComponent(location.pathname);
          link.textContent = " Continue";
          status.append(link);
        }
      } finally {
        button.disabled = false;
      }
    });
  }
  const form = document.querySelector<HTMLFormElement>("[data-chart-filters]");
  const drawer = document.querySelector<HTMLDetailsElement>(".print-filter-drawer");
  if (drawer && matchMedia("(max-width: 730px)").matches) drawer.open = false;
  function filter() {
    if (!form) return;
    const values = new FormData(form);
    let count = 0;
    document
      .querySelectorAll<HTMLElement>("[data-chart-card]")
      .forEach((card) => {
        card.hidden = ["edition", "paper", "orientation", "color", "subject", "pages"].some(
          (key) => values.get(key) && card.dataset[key] !== values.get(key),
        );
        if (!card.hidden) count++;
      });
    document.querySelector("[data-chart-count]")!.textContent =
      count === Number(form.dataset.total) ? `Showing all ${count} designs` : `Showing ${count} of ${form.dataset.total} designs`;
    const reset = document.querySelector<HTMLButtonElement>(".chart-filter-reset");
    if (reset) reset.disabled = ![...values.values()].some(Boolean);
    document.querySelector<HTMLElement>("[data-empty-charts]")!.hidden =
      count !== 0;
  }
  form?.addEventListener("change", filter);
  form?.addEventListener("reset", () => setTimeout(filter, 0));
</script>
