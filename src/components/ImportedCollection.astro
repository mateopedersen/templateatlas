---
import "../styles/imported-collection.css";
import TemplateProperties from "./TemplateProperties.astro";
import ImageLicenseMetadata from "./ImageLicenseMetadata.astro";
import HomeIcon from "./HomeIcon.astro";
import ImportedDownloads from "./ImportedDownloads.astro";
import ImportedPreview from "./ImportedPreview.astro";
import PrintScaleNote from "./PrintScaleNote.astro";
const { collection, item } = Astro.props;
const weekly = collection.id === "52-week-savings";
const savings = collection.kind === "savings" || collection.id === "100-envelope-savings";
const application = collection.kind === "application";
const petRecord = collection.kind === "pet-record";
const bracket = collection.kind === "bracket";
const protractor = collection.kind === "protractor";
const evaluation = collection.kind === "employee-evaluation";
const snow = collection.kind === "snow-contract";
const receipt = collection.kind === "acknowledgment-receipt";
const fiveWhys = collection.kind === "five-whys";
const ruler = collection.kind === "ruler";
const babyFeeding = collection.kind === "baby-feeding";
const agency = collection.kind === "agency-agreement" || collection.kind === "catering-contract";
const catering = collection.kind === "catering-contract";
const dedication = collection.kind === "baby-dedication";
const well = collection.kind === "well-plate";
const sbar = collection.kind === "sbar";
const apology = collection.kind === "apology-letter";
const complaint = collection.kind === "complaint-letter";
const letterCollection = apology || complaint;
const accident = collection.kind === "accident-report";
const trailer = collection.kind === "trailer-sale";
const vehicleBillOfSale = collection.kind === "vehicle-bill-of-sale";
const ant = collection.kind === "ant-reference";
const bee = collection.kind === "bee-reference";
const barGraph = collection.kind === "bar-graph";
const morseChart = collection.kind === "morse-code-chart";
const naturalReference = ant || bee;
const chartCollection = naturalReference || barGraph || morseChart;
const bankReconciliation = collection.kind === "bank-reconciliation";
const shiftSchedule = collection.kind === "shift-schedule";
const cornellNotes = collection.kind === "cornell-notes";
const nursingNotes = collection.kind === "nursing-notes";
const rubric = collection.kind === "rubric";
const lateRentNotice = collection.kind === "late-rent-notice";
const dayPlan = collection.kind === "day-plan";
const continuityPlan = collection.kind === "business-continuity";
const tenFrame = collection.kind === "ten-frame";
const disciplinaryForm = collection.kind === "disciplinary-action";
const preserved = collection.preservedProduction === true;
const formCollection = disciplinaryForm || trailer || vehicleBillOfSale || application || evaluation || snow || receipt || agency || letterCollection || accident || bankReconciliation || shiftSchedule || lateRentNotice || rubric || dayPlan || continuityPlan;
const label = collection.navigation_label || (weekly ? "52-Week Savings" : savings ? "Savings Trackers" : petRecord ? "Dog Vaccination Record" : barGraph ? "Bar Graph" : shiftSchedule ? "DuPont Shift Schedules" : rubric ? "Rubric Templates" : dayPlan ? "30-60-90 Day Plans" : continuityPlan ? "Business Continuity Plans" : preserved ? collection.title : "R-134a Charts");
const noun = tenFrame ? "activities" : disciplinaryForm ? "forms" : preserved ? "templates" : dayPlan || continuityPlan ? "plans" : rubric ? "rubrics" : nursingNotes ? "notes" : cornellNotes ? "worksheets" : shiftSchedule ? "schedules" : bankReconciliation ? "workpapers" : trailer || vehicleBillOfSale ? "forms" : chartCollection ? "charts" : accident ? "reports" : letterCollection ? "letters" : lateRentNotice ? "notices" : sbar ? "forms" : dedication ? "certificates" : agency ? "agreements" : well ? "worksheets" : fiveWhys ? "worksheets" : ruler ? "rulers" : receipt ? "receipts" : snow ? "agreements" : evaluation ? "review forms" : protractor ? "protractors" : bracket ? "brackets" : application ? "applications" : savings ? "trackers" : petRecord ? "records" : "charts";
const editionFilterLabel = tenFrame ? "Math Skill" : disciplinaryForm ? "Review Area" : rubric ? "Rubric Structure" : dayPlan ? "Work Area" : continuityPlan ? "Business Context" : nursingNotes ? "Care Area" : cornellNotes ? "Edition" : shiftSchedule ? "Schedule horizon" : trailer || vehicleBillOfSale ? "Form Type" : naturalReference ? "Chart Type" : barGraph || morseChart ? "Chart Style" : accident ? "Report Type" : letterCollection ? "Letter Category" : lateRentNotice ? "Template Type" : sbar ? "Communication Area" : dedication ? "Occasion" : agency ? "Agreement Type" : well ? "Worksheet Type" : fiveWhys ? "Use Category" : ruler ? "Ruler Type" : babyFeeding ? "Chart Category" : receipt ? "Receipt Category" : snow ? "Service Type" : evaluation ? "Review Focus" : protractor ? "Instrument Type" : bracket ? "Team Count" : application ? "Application Type" : savings ? "Savings plan" : petRecord ? "Record type" : bankReconciliation ? "Workpaper Type" : "Data edition";
const allEditionsLabel = tenFrame ? "All Math Skills" : disciplinaryForm ? "All Review Areas" : rubric ? "All Rubric Structures" : dayPlan ? "All Work Areas" : continuityPlan ? "All Business Contexts" : nursingNotes ? "All Care Areas" : cornellNotes ? "All editions" : shiftSchedule ? "All schedule horizons" : trailer || vehicleBillOfSale ? "All Form Types" : naturalReference ? "All Chart Types" : barGraph || morseChart ? "All Chart Styles" : accident ? "All Report Types" : letterCollection ? "All Letter Categories" : lateRentNotice ? "All Template Types" : sbar ? "All Communication Areas" : dedication ? "All Occasions" : agency ? "All Agreement Types" : well ? "All Worksheet Types" : fiveWhys ? "All Use Categories" : ruler ? "All Ruler Types" : babyFeeding ? "All Chart Categories" : receipt ? "All Receipt Categories" : snow ? "All Service Types" : evaluation ? "All Review Focuses" : protractor ? "All Instrument Types" : bracket ? "All Team Counts" : application ? "All Application Types" : savings ? "All savings plans" : petRecord ? "All record types" : bankReconciliation ? "All Workpaper Types" : "All editions";
const items = collection.items.filter(
  (e: any) => !Astro.locals.held?.has(e.id),
);
const options = (key: string) =>
  ([...new Set(items.map((e: any) => e[key]))] as string[]).sort((a,b) => bracket && key === "edition" ? parseInt(a) - parseInt(b) : 0);
const imageSize = (entry: any) => entry.thumbnailSize || entry.previewSize;
const itemProperties = item ? [item.paper, item.orientation, item.color].filter(Boolean).join(" · ") : "";
const featuredPapers = tenFrame || disciplinaryForm ? [items.find((entry: any) => entry.color === "Color" && entry.orientation === "Portrait"), items.find((entry: any) => entry.color === "Color" && entry.orientation === "Landscape")].filter(Boolean) : preserved ? items.slice(0,2) : dayPlan || continuityPlan ? [items.find((entry: any) => entry.color === "Color"), items.find((entry: any) => entry.color === "Black-and-white")].filter(Boolean) : (cornellNotes || nursingNotes) ? [items.find((entry: any) => entry.color === "Color" && entry.orientation === "Portrait"), items.find((entry: any) => entry.color === "Color" && entry.orientation === "Landscape")].filter(Boolean) : rubric || barGraph || lateRentNotice || morseChart ? [items.find((entry: any) => entry.color === "Color"), items.find((entry: any) => entry.color === "Black-and-white")].filter(Boolean) : shiftSchedule ? [items.find((entry: any) => entry.edition === "28 days"), items.find((entry: any) => entry.edition === "Calendar month")].filter(Boolean) : formCollection ? items.slice(0,2) : [
  items.find((entry: any) => entry.orientation === "Landscape"),
  items.find((entry: any) => entry.orientation === "Portrait"),
].filter(Boolean);
---

<ImageLicenseMetadata images={item ? [item] : items} />
<nav class="breadcrumb imported-breadcrumb" aria-label="Breadcrumb">
  <a href="/" class="breadcrumb-home"><HomeIcon /><span>Home</span></a>
  <svg class="breadcrumb-divider" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg>
  <a href="/templates/">Templates</a>
  <svg class="breadcrumb-divider" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg>
  {item ? <a href={collection.topic_path}>{label}</a> : <span aria-current="page">{label}</span>}
  {item && <><svg class="breadcrumb-divider" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg><span aria-current="page">{item.design_label || item.family || item.title}</span></>}
</nav>
{!item && (
  <section class="print-cover" aria-labelledby="collection-title">
    <div class="print-cover-copy">
      <p>{preserved ? `${items.length} Previously Published Templates` : dayPlan || continuityPlan ? `${items.length} Printable Plans · ${options("edition").length} Work Areas` : `${items.length} Printable Designs`} {!preserved && !dayPlan && !continuityPlan && <><span aria-hidden="true">/</span> {options("edition").length} {tenFrame ? "Math Skills" : disciplinaryForm ? "Review Areas" : rubric ? "Rubric Styles" : nursingNotes ? "Care Areas" : cornellNotes ? "Editions" : shiftSchedule ? "Schedule Horizons" : trailer || vehicleBillOfSale ? "Form Types" : barGraph || morseChart ? "Chart Styles" : naturalReference ? "Chart Types" : accident ? "Report Categories" : letterCollection ? "Letter Categories" : lateRentNotice ? "Template Categories" : sbar ? "Communication Areas" : dedication ? "Occasions" : agency ? "Agreement Categories" : well ? "Worksheet Categories" : fiveWhys ? "Use Categories" : ruler ? "Ruler Types" : babyFeeding ? "Chart Categories" : receipt ? "Receipt Categories" : snow ? "Service Types" : evaluation ? "Review Types" : protractor ? "Instrument Types" : bracket ? "Team Counts" : application ? "Application Types" : savings ? "Savings Plans" : petRecord ? "Record Types" : bankReconciliation ? "Workpaper Types" : "Data Editions"}</>}</p>
      <h1 id="collection-title">{collection.title}</h1>
      <p class="print-cover-intro">{collection.lead || (savings ? "Choose a savings goal and a printable layout for your challenge." : "Choose a reference sheet for your units, paper size, and print setup.")}</p>
    </div>
    <div class="print-cover-art" aria-hidden="true">
      {featuredPapers.map((sheet: any) => <img src={sheet.thumbnailAsset ? `https://assets.templateatlas.com${sheet.thumbnailAsset.path}` : sheet.preview} width={imageSize(sheet)?.[0]} height={imageSize(sheet)?.[1]} alt="" fetchpriority="high" />)}
    </div>
  </section>
)}
{naturalReference && <aside class="ant-photo-notice" aria-label="Photograph credits and identification"><strong>Photograph Credits &amp; Identification</strong><p>{bee ? "These charts include public-domain and individually licensed third-party photographs." : "These charts include third-party photographs under individual Creative Commons licenses."} Open the source and photograph credits in each PDF for attribution, license details, and image changes. Compare multiple traits with a regional identification key; photographs alone may not confirm a species.</p></aside>}
{collection.print_note && <PrintScaleNote note={collection.print_note}/>}
<div class:list={["workspace", "imported-workspace", { "imported-browse": !item }]}>
  <aside class:list={["panel", "imported-controls", {"application-controls":application}]}>
    {item && !preserved && <p class="over">{tenFrame ? "Ten Frame Activity" : disciplinaryForm ? "Disciplinary Action Form" : dayPlan ? "30-60-90 Day Plan" : continuityPlan ? "Business Continuity Plan" : rubric ? "Rubric Template" : nursingNotes ? "Nursing Note Template" : cornellNotes ? "Cornell Notes Worksheet" : shiftSchedule ? "DuPont Shift Schedule" : vehicleBillOfSale ? collection.item_label : trailer ? "Trailer Bill of Sale" : bee ? "Bee Identification Chart" : ant ? "Ant Identification Chart" : morseChart ? "Morse Code Chart" : barGraph ? "Bar Graph Template" : accident ? "Accident Report" : complaint ? "Complaint Letter" : apology ? "Apology Letter" : lateRentNotice ? "Late Rent Notice Template" : sbar ? "SBAR Communication" : dedication ? "Baby Dedication Certificate" : catering ? "Catering Contract" : agency ? "Agency Agreement" : well ? "96-Well Plate Worksheet" : fiveWhys ? "5 Whys Worksheet" : ruler ? "Printable Ruler" : babyFeeding ? "Baby Feeding" : receipt ? "Acknowledgment Receipt" : snow ? "Snow Removal Contract" : evaluation ? "Employee Evaluation" : protractor ? "Measuring Instrument" : bracket ? "Tournament Bracket" : application ? "Commercial Application" : savings ? "Savings tracker" : petRecord ? "Dog vaccination record" : bankReconciliation ? "Bank Reconciliation Workpaper" : "Refrigerant reference"}</p>}
    {item && <h2>{tenFrame ? "Download This Activity" : disciplinaryForm ? "Download This Form" : preserved ? "Download This Template" : dayPlan || continuityPlan ? "Download This Plan" : rubric ? "Download This Rubric" : lateRentNotice ? "Download This Notice" : nursingNotes ? "Download This Note" : cornellNotes ? "Download This Worksheet" : shiftSchedule ? "Download This Schedule" : vehicleBillOfSale || trailer ? "Download This Form" : accident ? "Download This Report" : letterCollection ? "Download This Letter" : sbar ? "Download This Form" : dedication ? "Download This Certificate" : agency ? "Download This Agreement" : well ? "Download This Worksheet" : fiveWhys ? "Download This Worksheet" : ruler ? "Download This Ruler" : receipt ? "Download This Receipt" : snow ? "Download This Agreement" : evaluation ? "Download This Review" : protractor ? "Download This Protractor" : bracket ? "Download This Bracket" : application ? "Download This Application" : savings ? "Download This Tracker" : petRecord ? "Download This Record" : bankReconciliation ? "Download This Workpaper" : "Download This Chart"}</h2>}
    {item ? (
      <>
        {itemProperties && <p>{itemProperties}</p>}
        <ImportedDownloads entry={item}/>
        <dl class="imported-facts">
          {!preserved && !tenFrame && !disciplinaryForm && !rubric && !dayPlan && !continuityPlan && !trailer && !vehicleBillOfSale && !naturalReference && !barGraph && !morseChart && !accident && !letterCollection && !lateRentNotice && !sbar && !dedication && !agency && !well && !fiveWhys && !ruler && !babyFeeding && !receipt && !savings && !application && !petRecord && !bracket && !protractor && !evaluation && !snow && !bankReconciliation && !shiftSchedule && !cornellNotes && !nursingNotes && <> <dt>Reference grid</dt>
          <dd>{item.range}</dd>
          <dt>Data rows</dt>
          <dd>{item.rows}</dd>
          <dt>Units</dt>
          <dd>{item.units.join(" · ")}</dd>
          </>}
          {savings && <><dt>Savings goal</dt><dd>{"$" + item.goal.toLocaleString("en-US")}</dd></>}
          {rubric && <><dt>Rubric structure</dt><dd>{item.edition}</dd><dt>Criteria</dt><dd>{item.criteria.join(" · ")}</dd></>}
          {tenFrame && <><dt>Math Skill</dt><dd>{item.edition}</dd><dt>Fillable PDF Fields</dt><dd>{item.pdf_fields}</dd><dt>Excel Activity Sheets</dt><dd>{item.excel_activity_sheets}</dd></>}
          {disciplinaryForm && <><dt>Review Area</dt><dd>{item.edition}</dd><dt>Fillable PDF Fields</dt><dd>{item.pdf_fields}</dd></>}
          {application && <><dt>Business Use</dt><dd>{item.subject}</dd><dt>Application Type</dt><dd>{item.editionLabel || item.edition}</dd></>}
          {cornellNotes && <><dt>Subject</dt><dd>{item.subject}</dd><dt>Activity</dt><dd>{item.activity}</dd><dt>Fillable PDF Fields</dt><dd>{item.pdf_fields}</dd></>}
          {shiftSchedule && <><dt>Planning Area</dt><dd>{item.subject}</dd><dt>Schedule View</dt><dd>{item.edition}</dd><dt>Workbook Tabs</dt><dd>{item.xlsx_sheets.join(" · ")}</dd></>}
          {protractor && <><dt>Angle Range</dt><dd>{item.angle_range}</dd><dt>Print-Check Square</dt><dd>20 × 20 mm</dd></>}
          {bracket && <><dt>Participants</dt><dd>{item.teams} Teams</dd><dt>Rounds</dt><dd>{item.rounds}</dd><dt>First-Round Byes</dt><dd>{item.byes}</dd></>}
          {petRecord && <><dt>Record Type</dt><dd>{item.edition}</dd><dt>PDF Form Fields</dt><dd>{item.pdf_fields}</dd><dt>Word Content Controls</dt><dd>{item.docx_controls}</dd></>}
          {fiveWhys && <><dt>Fillable PDF Fields</dt><dd>{item.pdf_fields}</dd></>}
          {barGraph && <><dt>Chart Style</dt><dd>{item.edition}</dd><dt>Categories</dt><dd>{item.category_count}</dd><dt>Data Series</dt><dd>{item.chart_series}</dd><dt>Workbook Tabs</dt><dd>{item.xlsx_sheets.join(" · ")}</dd><dt>Word Report</dt><dd>{item.pages} Pages</dd></>}
          {bankReconciliation && <><dt>Workbook Tabs</dt><dd>{item.xlsx_sheets.join(" · ")}</dd><dt>Word Length</dt><dd>{item.pages} {item.pages===1 ? "page" : "pages"}</dd></>}
          {!rubric && !preserved && item.pixels && <><dt>Image dimensions</dt><dd>{item.pixels.join(" × ")} px</dd></>}
          {!rubric && !preserved && !bankReconciliation && !barGraph && item.pages && <><dt>PDF length</dt><dd>{item.pages} {item.pages===1 ? "page" : "pages"}</dd></>}
        </dl>
        <a href={collection.topic_path}>Browse all {items.length} {noun} →</a>
      </>
    ) : preserved ? (
      <div class="finder-results preserved-count">
        <p role="status">Showing all {items.length} previously published templates</p>
      </div>
    ) : (
      <>
        <details class="print-filter-drawer" open>
          <summary><span class="finder-title"><span class="finder-title-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span><span><strong>Print options</strong><small>Choose your format</small></span></span></summary>
          <form id="chart-filters" data-chart-filters data-total={items.length} data-item-noun={noun}>
            {cornellNotes && <><div class="print-filter-field"><span>Subject</span><select name="subject" aria-label="Subject"><option value="">All subjects</option>{options("subject").map(value=><option value={value}>{value}</option>)}</select></div><div class="print-filter-field"><span>Activity</span><select name="activity" aria-label="Activity"><option value="">All activities</option>{options("activity").map(value=><option value={value}>{value}</option>)}</select></div></>}
            {shiftSchedule && <div class="print-filter-field"><span>Planning area</span><select name="subject" aria-label="Planning area"><option value="">All planning areas</option>{options("subject").map(value=><option value={value}>{value}</option>)}</select></div>}
            {application && <div class="print-filter-field"><span>Business Use</span><select name="subject" aria-label="Business Use"><option value="">All Business Uses</option>{options("subject").sort((a,b)=>a.localeCompare(b,'en-US')).map(value=><option value={value}>{value}</option>)}</select></div>}
            {(rubric || snow || agency || letterCollection || accident || vehicleBillOfSale || (barGraph && !morseChart) || shiftSchedule) ? null : formCollection ? <fieldset class="layout-picker">
              <legend>{bankReconciliation ? "Workpaper Length" : "Form Length"}</legend>
              <div class="layout-samples">
                {options("pages").sort((a,b)=>Number(a)-Number(b)).map(pages=>{const example=items.find((entry:any)=>entry.pages===pages);return <label><input type="radio" name="pages" value={String(pages)}/><span class="layout-choice"><span class="layout-proof"><img src={example.thumbnailAsset ? `https://assets.templateatlas.com${example.thumbnailAsset.path}` : example.preview} alt="" loading="lazy"/></span><span class="layout-name">{pages} {Number(pages)===1?'Page':'Pages'}</span></span></label>;})}
              </div>
              <label class="layout-any"><input type="radio" name="pages" value="" checked/> Any Length</label>
            </fieldset> : <fieldset class="layout-picker">
              <legend>Page layout</legend>
              <div class="layout-samples">
                {options("orientation").map(layout => {
                  const example = items.find((entry: any) => entry.orientation === layout);
                  return <label>
                    <input type="radio" name="orientation" value={layout} />
                    <span class="layout-choice"><span class="layout-proof"><img src={example.thumbnailAsset ? `https://assets.templateatlas.com${example.thumbnailAsset.path}` : example.preview} alt="" loading="lazy" /></span><span class="layout-name">{layout}</span></span>
                  </label>;
                })}
              </div>
              <label class="layout-any"><input type="radio" name="orientation" value="" checked /> Any layout</label>
            </fieldset>}
            {(["edition", "paper", "color"] as const).filter(key=>(key!=="paper" || (!tenFrame && !rubric && !nursingNotes && !cornellNotes && !barGraph && (!formCollection || options("paper").length>1))) && (key!=="color" || !cornellNotes)).map(key => (
              <div class="print-filter-field">
                <span>{key === "edition" ? editionFilterLabel : key === "paper" ? "Paper size" : "Print style"}</span>
                <select name={key} aria-label={key === "edition" ? editionFilterLabel : key === "paper" ? "Paper size" : "Print style"}>
                  <option value="">{key === "edition" ? allEditionsLabel : key === "paper" ? "All sizes" : "All styles"}</option>
                  {options(key).map(value => <option value={value}>{value === "US Letter" ? "US Letter (8.5 × 11 in)" : value === "A4" ? "A4 (210 × 297 mm)" : value === "Tabloid" ? "Tabloid (11 × 17 in)" : value === "ANSI C" ? "ANSI C (17 × 22 in)" : value}</option>)}
                </select>
              </div>
            ))}
          </form>
        </details>
        <div class="finder-results">
          <p role="status" data-chart-count>Showing all {items.length} {noun}</p>
          <button type="reset" form="chart-filters" class="chart-filter-reset" disabled>Reset filters</button>
        </div>
      </>
    )}
  </aside>
  <article class="imported-content">
    {item && <><p class="over">{preserved ? "Published Template" : item.design_label || item.family}</p><h1>{item.title}</h1><p class="lead">{item.intro}</p></>}
    {item ? (
      <>
        {item.description_paragraphs.length > 0 && <section class="imported-description" aria-label="About this template">
          {item.description_paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
        </section>}
        {(tenFrame || disciplinaryForm || evaluation || snow || agency || accident || trailer || vehicleBillOfSale || naturalReference || barGraph || morseChart || bankReconciliation || shiftSchedule || nursingNotes || lateRentNotice || dayPlan || continuityPlan) && item.pages > 1 && <p class="document-page-caption">{tenFrame ? `First-page preview · complete ${item.pages}-page activity in PDF, Word, and Excel` : dayPlan ? `First-page preview · complete ${item.pages}-page PDF and editable Word file` : continuityPlan ? `First-page preview · complete ${item.pages}-page PDF and editable Word file` : nursingNotes ? `First-page preview · complete ${item.pages}-page PDF and editable Word file` : shiftSchedule ? `First-page preview · complete ${item.pages}-page PDF and editable Word and Excel files` : barGraph ? `First-page preview · ${item.pages}-page Word report and Excel workbook` : bankReconciliation ? `First-page preview · ${item.pages}-page Word workpaper and Excel workbook` : item.previewPages?.length > 1 ? `Preview all ${item.pages} pages · Select a page and click to zoom` : `First-page preview · ${item.pages}-page PDF and Word files`}</p>}
        <ImportedPreview item={item}/>
        {tenFrame || preserved || disciplinaryForm || dayPlan || continuityPlan ? <section class="imported-source-note"><h2>{collection.usage_title}</h2>{collection.usage_paragraphs.map((paragraph:string)=><p>{paragraph}</p>)}</section> : vehicleBillOfSale ? <section class="imported-source-note"><h2>{collection.usage_title}</h2>{collection.usage_paragraphs.map((paragraph:string)=><p>{paragraph}</p>)}</section> : (rubric || nursingNotes || cornellNotes || shiftSchedule || agency || well || dedication || sbar || letterCollection || accident || trailer || naturalReference || barGraph || bankReconciliation || lateRentNotice) ? <section class="imported-source-note"><h2>{rubric || lateRentNotice ? collection.usage_title : nursingNotes || cornellNotes || barGraph || morseChart || bankReconciliation || shiftSchedule ? collection.usage_title : trailer ? "Using This Form" : naturalReference || morseChart ? "Using This Chart" : accident ? "Using This Report" : letterCollection ? "Using This Letter" : sbar ? "Using This Form" : dedication ? "Using This Certificate" : agency ? "Using This Agreement" : "Using This Worksheet"}</h2>{collection.usage_paragraphs.map((paragraph:string)=><p>{paragraph}</p>)}{lateRentNotice && <p><a href={`${collection.topic_path}#official-rent-resources`}>Review official housing and state resources before use →</a></p>}{apology && item.pdf_fields < 21 && <p>Some PDF labels and nearby text share an editable field. Use the Word version to edit them separately.</p>}</section> : fiveWhys ? <section class="imported-source-note"><h2>Using This Worksheet</h2>{collection.usage_paragraphs.map((paragraph:string)=><p>{paragraph}</p>)}</section> : ruler ? <section class="imported-source-note"><h2>Using This Ruler</h2>{collection.usage_paragraphs.map((paragraph:string)=><p>{paragraph}</p>)}</section> : babyFeeding ? <section class="imported-source-note"><h2>Using This Resource</h2>{collection.usage_paragraphs.map((paragraph:string)=><p>{paragraph}</p>)}<p>For curre