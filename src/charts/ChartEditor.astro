---
import { types, initial } from './model.mjs';
interface Props { topic?: string; templateId?: string }
const requested = Astro.props.topic ?? Astro.url.searchParams.get('topic') ?? 'line-chart';
const topic = Object.hasOwn(types, requested) ? requested : 'line-chart';
const model = initial(topic);
---
<section class="chart-studio" data-topic={topic} data-template={Astro.props.templateId || ''}>
  <div class="chart-top"><div><p class="eyebrow">TemplateAtlas / Charts &amp; Graphs</p><h1>Chart Studio</h1><p>Shape a chart from your data. Review the numbers and export a vector graphic.</p></div><span class="save-note" data-status role="status">Sample data loaded</span></div>
  <div class="chart-layout">
    <div class="controls">
      <div class="chart-tabs" role="group" aria-label="Editor sections"><button type="button" aria-pressed="true" data-tab="data">Data</button><button type="button" aria-pressed="false" data-tab="design">Design</button><button type="button" aria-pressed="false" data-tab="review">Review</button></div>
      <div data-pane="data"><h2>Edit data</h2><p data-schema>{types[topic as keyof typeof types].method}</p><p class="note" data-sample>Sample data — replace it with your own.</p>
        <div class="table-wrap" tabindex="0" role="region" aria-label="Editable data, scroll for more columns"><table data-grid></table></div>
        <div class="actions"><button type="button" data-add>Add row</button><button type="button" data-clear>Clear data</button></div>
        <details><summary>Paste data or import a file</summary><p>The first row sets the column headings. Match the column order above. Leave a missing optional number empty. For XLSX, use values on the first worksheet and ISO text for dates.</p><label>CSV or tab-separated data<textarea data-paste rows="4"></textarea></label>
        <label>Upload CSV, TSV, or an XLSX data sheet<input data-file type="file" accept=".csv,.tsv,.xlsx,text/csv,text/tab-separated-values,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"/></label><button type="button" data-import>Apply data</button></details>
      </div>
      <div data-pane="design" hidden><h2>Customize your chart</h2>
        <label>Chart title<input data-title maxlength="100" value={model.title}/></label>
        <label>Chart type<select data-type>{Object.entries(types).map(([v,d])=><option value={v} selected={v===topic}>{d.name}</option>)}</select></label>
        <p class="note">Choosing another type opens a separate draft.</p>
        <label>Axis or unit note<input data-axis maxlength="60" placeholder="For example, weekly hours"/></label>
        <label>Color palette<select data-palette><option value="ledger">Burgundy &amp; evergreen</option><option value="ocean">Ocean &amp; ocher</option></select></label>
        <label class="check"><input type="checkbox" data-legend checked/> Show series legend</label>
        <label class="check" data-gap-option><input type="checkbox" data-connect/> Connect points across missing values</label>
        <label data-bins-option>Histogram bins<input type="number" data-bins value="5" min="1" max="25"/></label>
        <label data-opening-option>Opening balance (USD)<input type="number" data-opening value="0" step=".01"/></label>
        <label data-week-option>Week starts on<select data-week><option>Sunday</option><option>Monday</option></select></label>
      </div>
      <div data-pane="review" hidden><h2>Review and export</h2><p data-summary></p><p>Your export uses the displayed data and revision. The download uses your account or visitor allowance.</p><label>File format<select data-format></select></label><div class="actions"><button type="button" data-save-doc>Save chart</button><button type="button" data-export>Download chart</button></div><p data-gate hidden><a href="/signup/">Create an account</a> · <a href="/pricing/">View membership</a></p></div>
      <p class="error" data-error aria-live="polite"></p>
    </div>
    <div class="preview"><div class="preview-heading"><h2>Chart preview</h2><span data-rev>Revision 1</span></div><div class="graph" data-graph></div><p data-method></p><details><summary>View data table</summary><div class="table-wrap" tabindex="0" aria-label="Chart data table" role="region"><table data-values></table></div></details></div>
  </div><noscript>Enable JavaScript to enter data and preview a chart.</noscript>
</section>
<script>
import './editor.mjs';
</script>
<style>
.chart-studio{--wine:#762d41;--paper:#fffefa;--line:#ded6ce;--muted:#645e58;color:#2f2925;font:normal 15px/1.55 system-ui,sans-serif;width:min(100%,1240px);margin:auto;padding:clamp(14px,3vw,42px);box-sizing:border-box}.chart-studio *{box-sizing:border-box}.chart-top,.preview-heading,.actions{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.chart-studio h1,.chart-studio h2{font-family:Georgia,serif;font-weight:500;line-height:1.12;margin:.2em 0 .45em}.chart-studio h1{font-size:clamp(37px,5vw,66px)}.chart-studio h2{font-size:25px}.chart-studio p{margin:8px 0 14px}.eyebrow,.save-note,.preview-heading span,.note{color:var(--muted);font-size:13px}.eyebrow{letter-spacing:.15em;text-transform:uppercase;color:var(--wine);font-weight:700}.chart-layout{display:grid;grid-template-columns:minmax(290px,.8fr) minmax(0,1.4fr);gap:24px;margin:22px 0}.controls,.preview{min-width:0;background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:clamp(12px,2vw,24px);align-self:start}.chart-tabs{display:flex;gap:6px;flex-wrap:wrap;border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:18px}.chart-studio button,.chart-studio input,.chart-studio select,.chart-studio textarea{font:inherit;color:inherit}.chart-studio button{cursor:pointer;color:var(--wine);background:#fff;border:1px solid #bbaaa3;border-radius:5px;padding:7px 11px;font-size:14px;font-weight:600}.chart-studio button:hover,.chart-studio button[aria-pressed=true],.chart-studio button[data-export]{background:var(--wine);color:white}.chart-studio button:disabled{opacity:.55;cursor:wait}.chart-studio :is(button,input,select,textarea,summary):focus-visible{outline:3px solid #176d88;outline-offset:2px}.chart-studio label{display:block;font-size:13px;font-weight:600;margin:12px 0}.chart-studio label>input:not([type=checkbox]),.chart-studio select,.chart-studio textarea,.chart-studio :global(td input),.chart-studio :global(th input){display:block;width:100%;border:1px solid #baafa5;background:#fff;border-radius:4px;padding:7px;min-width:0}.chart-studio [hidden]{display:none!important}.table-wrap{overflow:auto;max-height:350px}.chart-studio table{width:100%;border-collapse:collapse;font-size:13px}.chart-studio :global(td),.chart-studio :global(th){padding:3px;text-align:left;border-bottom:1px solid var(--line)}.chart-studio :global(th input){min-width:95px;color:var(--wine);font-weight:700}.chart-studio :global(td input){min-width:95px}.chart-studio :global(th small){font-weight:400;color:var(--muted)}.chart-studio .actions{justify-content:start;margin:10px 0}.chart-studio details{border-top:1px solid var(--line);margin-top:16px;padding-top:12px}.chart-studio summary{color:var(--wine);font-weight:650;cursor:pointer}.graph{background:white;border:1px solid var(--line);min-height:120px}.graph :global(svg){display:block;width:100%;height:auto}.error{color:#8c1736;font-weight:600}.error:empty{display:none}.chart-studio .check{display:flex;gap:8px;align-items:center}.chart-studio input[type=checkbox]{accent-color:var(--wine)}@media(max-width:820px){.chart-layout{grid-template-columns:minmax(0,1fr)}.chart-studio{padding-inline:12px}.controls,.preview{padding:14px}}
</style>
