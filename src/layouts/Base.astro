---
import Suggest from "../components/Suggest.astro";
import "../styles/site.css";
import "../styles/ledger.css";
import "../styles/studio.css";
import Icon from "../components/Icon.astro";
import Brand from "../components/Brand.astro";
const {
  title,
  description = "Browse editable documents, build charts from your own data, and plan your year with TemplateAtlas.",
  noindex = false,
} = Astro.props;
const path = Astro.url.pathname;
const accountCandidate =
  /(?:^|;\s*)(?:__Secure-)?better-auth\.session_token=/.test(
    Astro.request.headers.get("cookie") || "",
  );
const canonicalUrl = new URL(path, "https://templateatlas.com");
const page = Astro.url.searchParams.get("page");
if (
  page &&
  /^\d+$/.test(page) &&
  +page > 1 &&
  (path.startsWith("/categories/") || path === "/templates/")
)
  canonicalUrl.searchParams.set("page", page);
const canonical = canonicalUrl.href;
const info = Astro.props.entry;
const jsonLd = info
  ? {
      "@context": "https://schema.org",
      "@type": path === info.detail_path ? "CreativeWork" : "CollectionPage",
      name: title,
      description,
      url: canonical,
      inLanguage: "en-US",
      image: new URL(info.preview, "https://templateatlas.com").href,
      ...(path === info.detail_path
        ? {
            encodingFormat: info.formats.map(
              (f: string) => info.assets[f].mime,
            ),
          }
        : {}),
    }
  : path === "/"
    ? {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "TemplateAtlas",
        url: canonical,
        inLanguage: "en-US",
      }
    : null;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} · TemplateAtlas</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/templateatlas-world-3d.png" />
    <meta property="og:title" content={title + " · TemplateAtlas"} />
    <meta property="og:description" content={description} />
    {info && (
      <meta
        property="og:image"
        content={new URL(info.preview, "https://templateatlas.com")}
      />
    )}
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replaceAll("<", "\\u003c")}
      />
    )}
    <meta name="theme-color" content="#65162f" />
  </head>
  <body>
    <a href="#main" class="skip">
      Skip to content
    </a>
    <header class="masthead">
      <div class="bar container">
        <Brand />
        <form class="header-search" action="/search/">
          <Icon name="search" size={17} />
          <label for="global-search" class="sr">
            Search all templates
          </label>
          <input
            id="global-search"
            name="q"
            placeholder="Search templates, charts, and more…"
            autocomplete="off"
          />
          <button aria-label="Submit search">
            <Icon name="arrow" size={16} />
          </button>
        </form>
        <nav aria-label="Main navigation">
          <a href="/templates/">Templates</a>
          <a href="/create/">Create</a>
          <a href="/tools/">Tools</a>
          <a href="/help/">Resources</a>
        </nav>
        <div
          class="header-account"
          data-member={accountCandidate ? "possible" : "guest"}
        >
          <a class="signin" data-account href="/signin/">
            Sign in
          </a>
          <a class="button account-cta" href="/signup/">
            Create account <Icon name="arrow" size={14} />
          </a>
        </div>
      </div>
    </header>
    <Suggest />
    <main
      id="main"
      class:list={["container", { "home-container": path === "/" }]}
    >
      <slot />
    </main>
    <footer>
      <div class="container foot">
        <div>
          <Brand />
          <p>Documents, charts, and calendars for everyday work.</p>
        </div>
        <nav aria-label="Footer">
          <a href="/about/">About</a>
          <a href="/help/">Help</a>
          <a href="/legal/privacy/">Privacy</a>
          <a href="/contact/">Contact</a>
          <a href="/help/file-formats/">File guide</a>
        </nav>
      </div>
    </footer>
    <script>
      if (document.querySelector("[data-member=possible]"))
        fetch("/api/session")
          .then((r) => r.json())
          .then((s) => {
            if (s.user) {
              const a =
                document.querySelector<HTMLAnchorElement>("[data-account]")!;
              a.href = "/account/";
              a.textContent = "Your account";
              document
                .querySelector(".account-cta")
                ?.setAttribute("hidden", "");
            }
          })
          .catch(() => {});
    </script>
  </body>
</html>
